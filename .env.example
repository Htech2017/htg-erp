# Sao chep file nay thanh .env roi dien gia tri
PORT=3000
# Chuoi ngau nhien dai, tao bang: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Dat true khi chay sau HTTPS (reverse proxy)
COOKIE_SECURE=false
# Tuy chon: duong dan khac cho database / file khoa Google
# DB_PATH=./htech.db
# GOOGLE_KEYFILE=./credentials.json
