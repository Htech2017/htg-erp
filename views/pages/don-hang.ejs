<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-6 overflow-y-auto bg-gray-100 custom-scrollbar">
<div class="max-w-[1700px] mx-auto">

    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-800">Quản lý đơn hàng <%= orderType === 'rnd' ? 'R&D' : 'PCB / Linh kiện / Sản xuất' %></h1>
            <p class="text-sm text-gray-400 mt-0.5"><%= orderType === 'rnd' ? 'Đơn Nghiên cứu phát triển: thiết kế mạch, firmware...' : 'Đơn PCB, linh kiện, sản xuất (không gồm đơn R&D)' %> ·
                <a href="<%= orderType === 'rnd' ? '/don-hang/san-xuat' : '/don-hang/rnd' %>" data-role="<%= orderType === 'rnd' ? 'Admin,Sale' : 'Admin,Sale,Trưởng BP Thiết kế' %>" class="text-blue-600 hover:underline">sang <%= orderType === 'rnd' ? 'đơn PCB / Linh kiện / Sản xuất' : 'đơn R&D' %> →</a></p>
        </div>
        <div class="flex gap-2"><a href="/nhap-xuat-du-lieu?e=orders" class="bg-white border text-emerald-700 px-4 py-2.5 rounded-xl hover:bg-emerald-50 transition font-semibold text-sm flex items-center gap-2"><i class="fas fa-file-excel"></i> Nhập / xuất Excel</a>
        <button onclick="openModal()" class="bg-blue-600 text-white px-5 py-2.5 rounded-xl shadow hover:bg-blue-700 transition font-semibold text-sm flex items-center gap-2">
            <i class="fas fa-plus"></i> Tạo đơn hàng
        </button></div>
    </div>

    <!-- Canh bao don qua han chua chot -->
    <div id="overdueBanner" class="hidden bg-amber-50 border border-amber-300 rounded-xl p-4 mb-4 flex flex-wrap justify-between items-center gap-3"></div>

    <!-- KPI Cards -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6" id="kpiCards"></div>

    <!-- Filters + Table -->
    <div class="bg-white rounded-xl shadow-sm">
        <div class="flex flex-wrap gap-3 p-4 border-b">
            <input type="text" id="filterSearch" oninput="renderTable()" placeholder="Tìm mã ĐH, tên mạch, khách hàng..." class="flex-1 min-w-[200px] border rounded-lg px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-blue-400">
            <select id="filterStage" onchange="renderTable()" class="border rounded-lg px-3 py-2 text-sm bg-gray-50">
                <option value="">Tất cả (Giai đoạn)</option>
                <option value="__quaHan">⚠ Quá hạn chưa chốt</option>
                <option value="Chờ bộ phận báo giá">Chờ bộ phận báo giá</option>
                <option value="Chờ Sale báo khách">Chờ Sale báo khách</option>
                <option value="Chờ khách phản hồi">Chờ khách phản hồi</option>
                <option value="Đang thực hiện">Đang thực hiện</option>
                <option value="Chờ thu tiền">Chờ thu tiền</option>
                <option value="Hoàn thành">Hoàn thành</option>
                <option value="Không chốt">Không chốt</option>
                <option value="Đã hủy">Đã hủy</option>
            </select>
            <select id="filterChot" onchange="renderTable()" class="border rounded-lg px-3 py-2 text-sm bg-gray-50">
                <option value="">Tất cả (Chốt đơn)</option>
                <option value="Chờ phản hồi">Chờ phản hồi</option>
                <option value="Đã chốt">Đã chốt</option>
                <option value="Không chốt">Không chốt</option>
            </select>
            <select id="filterDonHang" onchange="renderTable()" class="border rounded-lg px-3 py-2 text-sm bg-gray-50">
                <option value="">Tất cả (Trạng thái)</option>
                <option value="Chờ báo giá">Chờ báo giá</option>
                <option value="Đang thiết kế">Đang thiết kế</option>
                <option value="Chờ nghiệm thu">Chờ nghiệm thu</option>
                <option value="Đang mua hàng">Đang mua hàng</option>
                <option value="Vật tư về">Vật tư về</option>
                <option value="Đang sản xuất">Đang sản xuất</option>
                <option value="QC">QC</option>
                <option value="Giao hàng">Giao hàng</option>
                <option value="Hoàn thành">Hoàn thành</option>
                <option value="Đã hủy">Đã hủy</option>
            </select>
            <select id="filterLoai" onchange="renderTable()" class="border rounded-lg px-3 py-2 text-sm bg-gray-50">
                <option value="">Tất cả loại</option>
                <option value="pcb">— Có PCB</option>
                <option value="lk">— Có Linh kiện</option>
                <option value="gc">— Có Sản xuất</option>
            </select>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left whitespace-nowrap">
                <thead class="bg-gray-50 text-gray-500 text-xs uppercase border-b">
                    <tr>
                        <th class="px-4 py-3">Mã ĐH</th>
                        <th class="px-4 py-3">Khách hàng</th>
                        <th class="px-4 py-3">Tên mạch / Dự án</th>
                        <th class="px-4 py-3 text-center">PCB</th>
                        <th class="px-4 py-3 text-center">LK</th>
                        <th class="px-4 py-3 text-center">SX</th>
                        <th class="px-4 py-3">Giai đoạn</th>
                        <th class="px-4 py-3">Tiến độ đơn</th>
                        <th class="px-4 py-3">Giá báo (đ)</th>
                        <th class="px-4 py-3">Ngày tạo</th>
                        <th class="px-4 py-3 text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="order-tbody"></tbody>
            </table>
        </div>
        <div id="paginationBar" class="flex justify-between items-center px-4 py-3 border-t text-xs text-gray-500"></div>
    </div>
</div>

<!-- =================== MODAL =================== -->
<div id="modalDH" class="fixed inset-0 bg-black bg-opacity-60 hidden items-center justify-center p-4 z-50 overflow-y-auto" style="display:none">
<div class="bg-white rounded-2xl w-full max-w-5xl shadow-2xl my-8 flex flex-col" style="max-height:92vh">

    <!-- Modal Header -->
    <div class="px-6 py-4 border-b flex justify-between items-center bg-slate-50 rounded-t-2xl shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 bg-blue-600 rounded-xl flex items-center justify-center text-white">
                <i class="fas fa-file-invoice text-sm"></i>
            </div>
            <div>
                <h2 id="modalTitle" class="font-bold text-slate-800 text-sm">Đơn hàng mới</h2>
                <p id="modalSubtitle" class="text-[10px] text-gray-400 uppercase tracking-widest">Hệ thống H-TECH ERP</p>
                <p id="ownerInfo" class="text-[11px] text-gray-500 mt-0.5"></p>
            </div>
        </div>
        <button type="button" onclick="closeModal()" class="text-gray-400 hover:text-red-500 transition">
            <i class="fas fa-times-circle text-xl"></i>
        </button>
    </div>

    <!-- Tab Nav -->
    <div class="flex border-b bg-white shrink-0 px-4 gap-1 pt-2">
        <button type="button" onclick="switchTab(1)" id="tab-btn-1" class="tab-btn px-4 py-2 text-sm font-semibold rounded-t-lg border border-b-0 border-blue-500 bg-blue-50 text-blue-700">
            <i class="fas fa-info-circle mr-1"></i>1. Thông tin
        </button>
        <button type="button" onclick="switchTab(3)" id="tab-btn-3" class="tab-btn px-4 py-2 text-sm font-semibold rounded-t-lg text-gray-500 hover:bg-gray-50 border border-transparent">
            <i class="fas fa-dollar-sign mr-1"></i>2. Báo giá &amp; chốt đơn
        </button>
        <button type="button" onclick="switchTab(4)" id="tab-btn-4" class="tab-btn px-4 py-2 text-sm font-semibold rounded-t-lg text-gray-500 hover:bg-gray-50 border border-transparent">
            <i class="fas fa-tasks mr-1"></i>3. Tiến độ &amp; thanh toán
        </button>
        <button type="button" onclick="switchTab(2)" id="tab-btn-2" class="tab-btn px-4 py-2 text-sm font-semibold rounded-t-lg text-gray-500 hover:bg-gray-50 border border-transparent">
            <i class="fas fa-folder-open mr-1"></i>4. Thư mục Drive
        </button>
        <span id="newOrderHint" class="hidden self-center ml-2 text-xs text-gray-400">Lưu đơn xong sẽ có các bước tiếp theo: báo giá, chốt đơn, tiến độ.</span>
    </div>

    <!-- Form -->
    <form id="formDH" onsubmit="handleSaveOrder(event)" class="flex-1 overflow-y-auto">
        <input type="hidden" id="dh_id">
        <input type="hidden" id="folderId_hidden">
        <input type="hidden" id="inputFolderId_hidden">
        <input type="hidden" id="outputFolderId_hidden">
        <input type="hidden" id="documentFolderId_hidden">
        <input type="hidden" id="dh_maDH">

        <!-- ===== TAB 1: THONG TIN ===== -->
        <div id="tab-1" class="tab-pane p-5">
            <!-- Loai don hang: chi chon khi tao moi -->
            <div class="mb-4 flex flex-wrap items-center gap-3">
                <p class="text-xs font-bold text-gray-600 uppercase tracking-wide">Loại đơn hàng</p>
                <div class="flex flex-wrap gap-2">
                    <label class="type-card flex items-center gap-2 border-2 rounded-lg px-3 py-1.5 cursor-pointer transition" data-type="rnd">
                        <input type="radio" name="loaiDV" value="rnd" class="accent-violet-600" onchange="applyOrderType()">
                        <span>
                            <span class="block text-sm font-bold text-violet-700"><i class="fas fa-flask mr-1"></i>Nghiên cứu phát triển (R&amp;D)</span>
                            <span class="hidden">Thiết kế, phát triển sản phẩm. Khi chốt đơn sẽ chuyển sang bộ phận Thiết kế.</span>
                        </span>
                    </label>
                    <label class="type-card flex items-center gap-2 border-2 rounded-lg px-3 py-1.5 cursor-pointer transition" data-type="sx">
                        <input type="radio" name="loaiDV" value="sx" class="accent-blue-600" onchange="applyOrderType()">
                        <span>
                            <span class="block text-sm font-bold text-blue-700"><i class="fas fa-industry mr-1"></i>PCB / Linh kiện / Sản xuất</span>
                            <span class="hidden">Đặt PCB, mua linh kiện, sản xuất. Khi chốt đơn sẽ chuyển sang Mua hàng và Sản xuất.</span>
                        </span>
                    </label>
                </div>
                <p id="typeLockedNote" class="text-xs text-gray-400 hidden"><i class="fas fa-lock mr-1"></i>Loại đơn không đổi được sau khi đã tạo.</p>
            </div>
            <div class="grid grid-cols-12 gap-x-4 gap-y-3">
                <div class="col-span-12 md:col-span-5">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Khách hàng *</label>
                    <select id="dh_maKH" onchange="onKhachHangChange()" required class="w-full border rounded-lg px-2.5 py-1.5 text-sm bg-white focus:ring-2 focus:ring-blue-400 outline-none">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                    <p id="khInfo" class="text-[11px] text-gray-500 mt-1 truncate"></p>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <label id="lbl_tenMach" class="block text-xs font-semibold text-gray-500 mb-1">Tên mạch / Sản phẩm *</label>
                    <input type="text" id="dh_tenMach" required placeholder="VD: Mạch điều khiển động cơ" class="w-full border rounded-lg px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">
                </div>
                <div class="col-span-12 md:col-span-2">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Ngày tạo *</label>
                    <input type="date" id="dh_ngayTao" required class="w-full border rounded-lg px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">
                </div>
                <div class="col-span-12 md:col-span-3 admin-only hidden">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Sale phụ trách (Admin đổi)</label>
                    <select id="dh_saleName" class="w-full border rounded-lg px-2.5 py-1.5 text-sm bg-white focus:ring-2 focus:ring-blue-400 outline-none"></select>
                </div>
                <div class="col-span-12 md:col-span-3 admin-only hidden">
                    <label class="block text-xs font-semibold text-gray-500 mb-1" title="Dùng cho báo giá PDF và báo cáo theo thương hiệu">Thương hiệu</label>
                    <select id="dh_brandId" class="w-full border rounded-lg px-2.5 py-1.5 text-sm bg-white focus:ring-2 focus:ring-blue-400 outline-none"></select>
                </div>
                <!-- Cac loai mach cua don (chi cho don loai sx): moi loai mach co so luong, BOM va gia cost rieng -->
                <div class="col-span-12 md:col-span-12" id="wrapItems">
                    <div class="flex justify-between items-center mb-2">
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                            <p class="text-xs font-bold text-gray-600 uppercase tracking-wide">Các loại mạch trong đơn *</p>
                            <span class="text-[11px] text-gray-400">Tick hạng mục khách đặt ở từng dòng (mỗi mạch có thể khác nhau). Hạng mục không tick sẽ không chuyển cho bộ phận đó.</span>
                        </div>
                        <button type="button" id="btnAddItem" onclick="addOrderItem()" class="text-xs font-bold text-blue-600 hover:underline"><i class="fas fa-plus mr-1"></i>Thêm loại mạch</button>
                    </div>
                    <div class="overflow-x-auto border rounded-xl">
                        <table class="w-full text-sm">
                            <thead class="bg-gray-50 text-gray-500 text-[11px] uppercase">
                                <tr>
                                    <th class="px-3 py-2 text-left">Tên mạch / sản phẩm</th>
                                    <th data-svc="soLuongPCB" class="px-3 py-2 text-right text-blue-600">PCB (tấm)</th>
                                    <th data-svc="soLuongLK" class="px-3 py-2 text-right text-purple-600">Linh kiện (bộ)</th>
                                    <th data-svc="soLuongGiaCong" class="px-3 py-2 text-right text-orange-600">Sản xuất (cái)</th>
                                    <th class="px-3 py-2 text-left">Thư mục dữ liệu</th>
                                    <th class="px-3 py-2 text-right">Cost đã báo</th>
                                    <th class="px-3 py-2"></th>
                                </tr>
                            </thead>
                            <tbody id="orderItemsBody"></tbody>
                        </table>
                    </div>
                    <p class="text-[11px] text-gray-400 mt-1">Đổi số lượng của mạch nào thì bộ phận phải báo giá lại cho mạch đó. <span id="itemsLockedNote" class="hidden"><i class="fas fa-lock mr-1"></i>Đơn đã chốt: không sửa được danh sách loại mạch và số lượng.</span></p>
                </div>
                <!-- Tong so luong (tu dong cong tu cac loai mach, khong nhap tay) -->
                <div class="col-span-12 md:col-span-12 hidden" id="wrapSoLuong">
                    <p class="text-xs font-bold text-gray-600 mb-2 uppercase tracking-wide">Số lượng đặt hàng</p>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="bg-blue-50 border border-blue-200 rounded-xl p-3">
                            <label class="block text-xs font-semibold text-blue-600 mb-1"><i class="fas fa-microchip mr-1"></i>PCB (tấm)</label>
                            <input type="number" id="dh_soLuongPCB" min="0" value="0" class="w-full border border-blue-300 rounded-lg px-2.5 py-1.5 text-sm font-bold bg-white focus:ring-2 focus:ring-blue-400 outline-none">
                        </div>
                        <div class="bg-purple-50 border border-purple-200 rounded-xl p-3">
                            <label class="block text-xs font-semibold text-purple-600 mb-1"><i class="fas fa-puzzle-piece mr-1"></i>Linh kiện (bộ)</label>
                            <input type="number" id="dh_soLuongLK" min="0" value="0" class="w-full border border-purple-300 rounded-lg px-2.5 py-1.5 text-sm font-bold bg-white focus:ring-2 focus:ring-purple-400 outline-none">
                        </div>
                        <div class="bg-orange-50 border border-orange-200 rounded-xl p-3">
                            <label class="block text-xs font-semibold text-orange-600 mb-1"><i class="fas fa-cogs mr-1"></i>Sản xuất (cái)</label>
                            <input type="number" id="dh_soLuongGiaCong" min="0" value="0" class="w-full border border-orange-300 rounded-lg px-2.5 py-1.5 text-sm font-bold bg-white focus:ring-2 focus:ring-orange-400 outline-none">
                        </div>
                    </div>
                </div>
                <div class="col-span-12 md:col-span-8">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Ghi chú kỹ thuật / yêu cầu đặc biệt</label>
                    <textarea id="dh_ghiChuKyThuat" rows="2" placeholder="Mô tả yêu cầu kỹ thuật, file tham khảo, tiêu chuẩn..." class="w-full border rounded-lg px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none resize-none"></textarea>
                </div>
                <div class="col-span-12 md:col-span-4">
                    <label class="block text-xs font-semibold text-gray-500 mb-1">Ghi chú đơn hàng</label>
                    <input type="text" id="dh_noteDH" placeholder="Ghi chú thêm..." class="w-full border rounded-lg px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">
                </div>
            </div>
        </div>

        <!-- ===== TAB 2: DRIVE ===== -->
        <div id="tab-2" class="tab-pane p-5 hidden">
            <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-5">
                <p class="text-sm font-semibold text-blue-700 mb-1"><i class="fas fa-info-circle mr-1"></i>Thư mục Google Drive được tạo tự động khi tạo đơn hàng</p>
                <p class="text-xs text-blue-500">Cấu trúc: Khách hàng → Mã ĐH → 1.INPUT / 2.OUTPUT / 3.Documents</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="bg-white border rounded-xl p-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-gray-400 uppercase font-semibold">Thư mục đơn hàng</p>
                        <p class="text-sm font-bold text-gray-700 mt-1" id="display_folderId">Chưa có</p>
                    </div>
                    <a id="link_folderId" href="#" target="_blank" class="text-blue-500 hover:text-blue-700 hidden"><i class="fas fa-external-link-alt text-lg"></i></a>
                </div>
                <div class="bg-white border rounded-xl p-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-yellow-500 uppercase font-semibold"><i class="fas fa-upload mr-1"></i>INPUT folder</p>
                        <p class="text-sm font-bold text-gray-700 mt-1" id="display_inputFolderId">Chưa có</p>
                    </div>
                    <a id="link_inputFolderId" href="#" target="_blank" class="text-blue-500 hover:text-blue-700 hidden"><i class="fas fa-external-link-alt text-lg"></i></a>
                </div>
                <div class="bg-white border rounded-xl p-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-green-500 uppercase font-semibold"><i class="fas fa-download mr-1"></i>OUTPUT folder</p>
                        <p class="text-sm font-bold text-gray-700 mt-1" id="display_outputFolderId">Chưa có</p>
                    </div>
                    <a id="link_outputFolderId" href="#" target="_blank" class="text-blue-500 hover:text-blue-700 hidden"><i class="fas fa-external-link-alt text-lg"></i></a>
                </div>
                <div class="bg-white border rounded-xl p-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-purple-500 uppercase font-semibold"><i class="fas fa-file-alt mr-1"></i>Documents folder</p>
                        <p class="text-sm font-bold text-gray-700 mt-1" id="display_documentFolderId">Chưa có</p>
                    </div>
                    <a id="link_documentFolderId" href="#" target="_blank" class="text-blue-500 hover:text-blue-700 hidden"><i class="fas fa-external-link-alt text-lg"></i></a>
                </div>
            </div>
            <div class="mt-4">
                <label class="block text-xs font-semibold text-gray-500 mb-1">Link thư mục tùy chỉnh (nếu có)</label>
                <input type="url" id="dh_driveLink" placeholder="https://drive.google.com/..." class="w-full border rounded-lg px-2.5 py-1.5 text-sm focus:ring-2 focus:ring-blue-400 outline-none">
            </div>
        </div>

        <!-- ===== TAB 3: BAO GIA ===== -->
        <div id="tab-3" class="tab-pane p-5 hidden">
            <!-- Canh bao: con bo phan chua bao gia -->
            <div id="quoteWarning" class="hidden bg-amber-50 border border-amber-300 text-amber-800 rounded-xl p-3 mb-5 text-sm">
                <i class="fas fa-hourglass-half mr-1"></i><span id="quoteWarningText"></span>
            </div>

            <!-- Chi phi R&D (chi cho don loai rnd) -->
            <div id="wrapCostRnd" class="bg-violet-50 border border-violet-200 rounded-xl p-4 mb-5 hidden">
                <h3 class="text-xs font-bold text-violet-600 uppercase tracking-wide mb-3"><i class="fas fa-flask mr-1"></i>Chi phí nghiên cứu phát triển</h3>
                <% const canQuoteRnd = !!(user && user.allRoles && (user.allRoles.includes('Admin') || user.allRoles.includes('Trưởng BP Thiết kế'))); %>
                <label class="block text-xs font-semibold text-gray-500 mb-1">Chi phí R&amp;D do bộ phận Thiết kế báo (đ)</label>
                <input type="number" id="dh_giaThietKe" step="1000" min="0" value="0" oninput="calcGiaBao()" <%= canQuoteRnd ? '' : 'readonly' %> class="<%= canQuoteRnd ? '' : 'bg-gray-100 text-gray-500 ' %>w-full border border-violet-300 rounded-lg px-2.5 py-1.5 text-sm font-bold bg-white focus:ring-2 focus:ring-violet-400 outline-none">
                <p class="text-xs text-gray-400 mt-1">Giá báo = Chi phí R&amp;D × Hệ số</p>
            </div>

            <!-- Cost from teams (read-only for sale, chi cho don loai sx) -->
            <div id="wrapCostSx" class="bg-gray-50 border rounded-xl p-4 mb-5">
                <h3 class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3"><i class="fas fa-calculator mr-1"></i>Giá cost nhập từ bộ phận</h3>
