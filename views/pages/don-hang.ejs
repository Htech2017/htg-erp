    </optgroup>
</select>
        <select id="filterPayment" onchange="renderTable()" class="border rounded-lg p-2 text-sm outline-none">
            <option value="Tất cả">Tất cả thanh toán</option>
            <option value="Còn nợ">Còn nợ công nợ</option>
