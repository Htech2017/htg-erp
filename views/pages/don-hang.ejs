// Thêm vào trong script
async function populateBrands() {
    try {
        const res = await fetch('/api/brands'); // Giả định bạn đã có API này
        const brands = await res.json();
        const select = document.getElementById('selectBrand');
        
        if (brands.length > 0) {
            select.innerHTML = brands.map(b => `<option value="${b.id}">${b.company}</option>`).join('');
        } else {
            select.innerHTML = '<option value="1">Brand Mặc Định</option>';
        }
    } catch (e) {
        console.error("Lỗi load Brand:", e);
    }
}

function toggleCancelNote() {
    const status = document.getElementById('ttQuyTrinh').value;
    const box = document.getElementById('cancelNoteBox');
    if (status === 'Hủy đơn') {
        box.classList.remove('hidden');
    } else {
        box.classList.add('hidden');
        document.getElementById('lyDoHuy').value = ''; // Reset khi không hủy
    }
}


window.onload = async () => {
    // Tải dữ liệu
    await populateCustomers(); 
    await renderTable();
    await populateBrands();

    const urlParams = new URLSearchParams(window.location.search);
    const maKHFromUrl = urlParams.get('addFor');

    if (maKHFromUrl) {
        // Bước 1: Gán giá trị vào select trước khi mở modal
        const selectKH = document.getElementById('maKH');
        if (selectKH) {
            selectKH.value = maKHFromUrl;
        }

        // Bước 2: Mở modal (Hàm openModal bây giờ đã biết giữ lại giá trị maKH)
        openModal(); 

        // Bước 3: Ép một lần nữa cho chắc chắn sau khi Form render xong
        setTimeout(() => {
            if (selectKH && selectKH.value !== maKHFromUrl) {
                selectKH.value = maKHFromUrl;
                updateMaDH();
            }
        }, 500);

        // Làm sạch URL
        window.history.replaceState({}, document.title, window.location.pathname);
    }
};
