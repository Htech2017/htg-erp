<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
// ---- DATA ----
const PAGE_TYPE = '<%= orderType %>'; // trang nay chi quan ly 1 loai don: 'rnd' hoac 'sx'
let allOrders = [];
let allCustomers = [];
let currentPage = 1;
const PAGE_SIZE = 15;

// Tien do rieng cho tung loai don
const PIPELINE_BY_TYPE = {
    rnd: ['Chờ báo giá','Đang thiết kế','Chờ nghiệm thu','Hoàn thành','Đã hủy'],
    sx:  ['Chờ báo giá','Đang mua hàng','Vật tư về','Đang sản xuất','QC','Giao hàng','Hoàn thành','Đã hủy']
};
const TYPE_BADGE = {
    rnd: '<span class="bg-violet-100 text-violet-700 rounded px-1.5 py-0.5 text-[10px] font-bold ml-1">R&amp;D</span>',
    sx:  '<span class="bg-sky-100 text-sky-700 rounded px-1.5 py-0.5 text-[10px] font-bold ml-1">SX</span>'
};
function currentOrderType() {
    const el = document.querySelector('input[name="loaiDV"]:checked');
    return el ? el.value : 'sx';
}
// An / hien cac phan cua form theo loai don dang chon
function applyOrderType() {
    const type = currentOrderType();
    const isRnd = type === 'rnd';
    document.getElementById('wrapItems').classList.toggle('hidden', isRnd);
    // Don sx: ten mach lay tu cac loai mach ben duoi; don R&D: 1 ten du an
    const tenMach = document.getElementById('dh_tenMach');
    tenMach.closest('div').classList.toggle('hidden', !isRnd);
    tenMach.required = isRnd;
    document.getElementById('wrapCostSx').classList.toggle('hidden', isRnd);
    document.getElementById('wrapCostRnd').classList.toggle('hidden', !isRnd);
    document.getElementById('lbl_tenMach').textContent = isRnd ? 'Tên dự án / Sản phẩm nghiên cứu *' : 'Tên mạch / Sản phẩm *';
    document.getElementById('heSoHint').textContent = isRnd ? 'Giá báo = Chi phí R&D × Hệ số' : 'Giá báo = Tổng cost × Hệ số';
    document.querySelectorAll('.type-card').forEach(card => {
        const on = card.dataset.type === type;
        card.classList.toggle('border-violet-500', on && isRnd);
        card.classList.toggle('bg-violet-50', on && isRnd);
        card.classList.toggle('border-blue-500', on && !isRnd);
        card.classList.toggle('bg-blue-50', on && !isRnd);
        card.classList.toggle('border-gray-200', !on);
    });
    const steps = PIPELINE_BY_TYPE[type];
    // Don dang sua (loai da khoa) giu nguyen trang thai cu; don moi doi loai thi quay ve buoc dau neu buoc dang chon khong thuoc loai moi
    const locked = document.querySelector('input[name="loaiDV"]').disabled;
    renderPipelineButtons(locked || steps.includes(selectedPipeline) ? selectedPipeline : 'Chờ báo giá');
}
function setOrderType(type, locked) {
    document.querySelectorAll('input[name="loaiDV"]').forEach(r => { r.checked = r.value === type; r.disabled = !!locked; });
    document.getElementById('typeLockedNote').classList.toggle('hidden', !locked);
    applyOrderType();
}

const CHOT_BADGE = {
    'Chờ phản hồi': 'bg-yellow-100 text-yellow-700',
    'Đã chốt': 'bg-green-100 text-green-700',
    'Không chốt': 'bg-red-100 text-red-600',
    '': 'bg-gray-100 text-gray-500'
};
const STAGE_BADGE = {
    'Chờ bộ phận báo giá': 'bg-amber-100 text-amber-700',
    'Chờ Sale báo khách':  'bg-orange-100 text-orange-700',
    'Chờ khách phản hồi':  'bg-yellow-100 text-yellow-700',
    'Đang thực hiện':      'bg-blue-100 text-blue-700',
    'Chờ thu tiền':        'bg-pink-100 text-pink-700',
    'Hoàn thành':          'bg-green-100 text-green-700',
    'Không chốt':          'bg-red-100 text-red-600',
    'Đã hủy':              'bg-gray-200 text-gray-600'
};
const PIPELINE_BADGE = {
    'Chờ báo giá':  'bg-gray-100 text-gray-600',
    'Đang thiết kế':'bg-violet-100 text-violet-700',
    'Chờ nghiệm thu':'bg-amber-100 text-amber-700',
    'Đang mua hàng':'bg-blue-100 text-blue-700',
    'Vật tư về':    'bg-cyan-100 text-cyan-700',
    'Đang sản xuất':'bg-indigo-100 text-indigo-700',
    'QC':           'bg-purple-100 text-purple-700',
    'Giao hàng':    'bg-orange-100 text-orange-700',
    'Hoàn thành':   'bg-green-100 text-green-700',
    'Đã hủy':       'bg-red-100 text-red-600'
};

// ---- LOAD ----
async function loadAll() {
    const [orders, customers] = await Promise.all([
        fetch('/api/orders').then(r=>r.json()),
        fetch('/api/customers').then(r=>r.json())
    ]);
    allOrders = (Array.isArray(orders) ? orders : []).filter(o => (o.loaiDV === 'rnd') === (PAGE_TYPE === 'rnd') && !o.vip); // lo hang VIP quan ly o trang rieng
    allCustomers = customers;
    if (PAGE_TYPE === 'rnd') document.getElementById('filterLoai').classList.add('hidden'); // don R&D khong chia PCB / linh kien / san xuat
    await loadSaleAndBrandOptions();
    renderKPIs();
    renderOverdueBanner();
    if (new URLSearchParams(location.search).get('quaHan') && !window.__quaHanApplied) { window.__quaHanApplied = true; document.getElementById('filterStage').value = '__quaHan'; }
    renderTable();
    populateCustomerDropdown();
    // Tu trang Khach hang: mo san form tao don voi khach da chon
    const addFor = new URLSearchParams(location.search).get('addFor');
    if (addFor && !window.__addForDone) {
        window.__addForDone = true;
        history.replaceState(null, '', location.pathname);
        if (allCustomers.some(c => c.maKH === addFor)) { openModal(); document.getElementById('dh_maKH').value = addFor; onKhachHangChange(); }
    }
}

function populateCustomerDropdown() {
    const sel = document.getElementById('dh_maKH');
    sel.innerHTML = '<option value="">-- Chọn khách hàng --</option>';
    allCustomers.forEach(c => {
        sel.innerHTML += `<option value="${c.maKH}">${c.maKH} - ${c.tenKH}</option>`;
    });
}

// ---- KPI ----
function renderKPIs() {
    // Dem theo giai doan cua quy trinh (server tinh san trong o.giaiDoan)
    const count = stage => allOrders.filter(o => o.giaiDoan === stage).length;
    const cards = [
        { label:'Chờ bộ phận báo giá', value: count('Chờ bộ phận báo giá'), color:'bg-amber-500', icon:'fa-hourglass-half' },
        { label:'Chờ Sale báo khách', value: count('Chờ Sale báo khách'), color:'bg-orange-500', icon:'fa-calculator' },
        { label:'Chờ khách phản hồi', value: count('Chờ khách phản hồi'), color:'bg-yellow-500', icon:'fa-clock' },
        { label:'Đang thực hiện', value: count('Đang thực hiện'), color:'bg-blue-600', icon:'fa-cogs' },
        { label:'Chờ thu tiền', value: count('Chờ thu tiền'), color:'bg-pink-600', icon:'fa-hand-holding-usd' }
    ];
    document.getElementById('kpiCards').innerHTML = cards.map(c => `
        <div class="bg-white rounded-xl shadow-sm p-4 flex items-center gap-3">
            <div class="w-10 h-10 ${c.color} rounded-xl flex items-center justify-center text-white">
                <i class="fas ${c.icon}"></i>
            </div>
            <div>
                <p class="text-2xl font-black text-gray-800">${c.value}</p>
                <p class="text-xs text-gray-400">${c.label}</p>
            </div>
        </div>`).join('');
}

// ---- CANH BAO DON QUA HAN CHUA CHOT ----
function renderOverdueBanner() {
    const box = document.getElementById('overdueBanner');
    const list = allOrders.filter(o => o.quaHan);
    if (!list.length) { box.classList.add('hidden'); return; }
    const days = list[0].warnDays || 10;
    const holding = list.filter(o => o.tamXuat).length;
    box.innerHTML = `
        <div>
            <p class="font-bold text-amber-800 text-sm"><i class="fas fa-exclamation-triangle mr-2"></i>${list.length} đơn đã quá ${days} ngày chưa chốt${holding ? ` (${holding} đơn đang giữ vật tư tạm xuất)` : ''}</p>
            <p class="text-xs text-amber-700 mt-0.5">Kiểm tra với khách rồi chuyển sang "Đã chốt" hoặc "Không chốt". Vật tư tạm xuất chỉ trả lại kho khi đơn Không chốt hoặc Hủy.</p>
        </div>
        <button onclick="document.getElementById('filterStage').value='__quaHan'; currentPage=1; renderTable()" class="bg-amber-500 text-white px-4 py-2 rounded-lg text-xs font-bold hover:bg-amber-600">Xem các đơn này</button>`;
    box.classList.remove('hidden');
}

// ---- TABLE ----
function renderTable() {
    const q = document.getElementById('filterSearch').value.toLowerCase();
    const chot = document.getElementById('filterChot').value;
    const stage = document.getElementById('filterStage').value;
    const donhang = document.getElementById('filterDonHang').value;
    const loai = document.getElementById('filterLoai').value;

    let filtered = allOrders.filter(o => {
        const matchQ = !q || (o.maDH||'').toLowerCase().includes(q) || (o.tenMach||'').toLowerCase().includes(q) || (o.customerName||'').toLowerCase().includes(q);
        const matchChot = !chot || o.ttChotDon === chot;
        const matchDH = !donhang || o.ttDonHang === donhang;
        const matchLoai = !loai ||
            (loai==='rnd' && o.loaiDV === 'rnd') ||
            (loai==='sx' && o.loaiDV === 'sx') ||
            (loai==='pcb' && o.soLuongPCB > 0) ||
            (loai==='lk' && o.soLuongLK > 0) ||
            (loai==='gc' && o.soLuongGiaCong > 0);
        return matchQ && matchChot && matchDH && matchLoai && (!stage || (stage === '__quaHan' ? o.quaHan : o.giaiDoan === stage));
    });

    const total = filtered.length;
    const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = 1;
    const paged = filtered.slice((currentPage-1)*PAGE_SIZE, currentPage*PAGE_SIZE);

    const tbody = document.getElementById('order-tbody');
    tbody.innerHTML = paged.length === 0
        ? `<tr><td colspan="11" class="text-center py-10 text-gray-400">Không có đơn hàng nào</td></tr>`
        : paged.map(o => {
            const chotBadge = CHOT_BADGE[o.ttChotDon||''] || 'bg-gray-100 text-gray-500';
            const pipelineBadge = PIPELINE_BADGE[o.ttDonHang||''] || 'bg-gray-100 text-gray-500';
            const gia = o.giaBao ? new Intl.NumberFormat('vi-VN').format(o.giaBao) : '---';
            return `<tr class="border-b hover:bg-gray-50 cursor-pointer" onclick="openEdit(${o.id})">
                <td class="px-4 py-3 font-bold text-blue-700">${o.maDH}${TYPE_BADGE[o.loaiDV] || ''}${o.vip ? ' <span class="bg-amber-100 text-amber-700 rounded px-1.5 py-0.5 text-[10px] font-bold" title="Lô hàng khách VIP"><i class="fas fa-crown"></i> VIP</span>' : ''}</td>
                <td class="px-4 py-3 text-gray-600">${o.customerName||o.maKH||''}</td>
                <td class="px-4 py-3 font-medium">${o.tenMach||''}</td>
                <td class="px-4 py-3 text-center">${o.soLuongPCB > 0 ? `<span class="bg-blue-100 text-blue-700 rounded px-1.5 py-0.5 text-xs font-bold">${o.soLuongPCB}</span>` : '<span class="text-gray-300">-</span>'}</td>
                <td class="px-4 py-3 text-center">${o.soLuongLK > 0 ? `<span class="bg-purple-100 text-purple-700 rounded px-1.5 py-0.5 text-xs font-bold">${o.soLuongLK}</span>` : '<span class="text-gray-300">-</span>'}</td>
                <td class="px-4 py-3 text-center">${o.soLuongGiaCong > 0 ? `<span class="bg-orange-100 text-orange-700 rounded px-1.5 py-0.5 text-xs font-bold">${o.soLuongGiaCong}</span>` : '<span class="text-gray-300">-</span>'}</td>
                <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full text-xs font-semibold ${STAGE_BADGE[o.giaiDoan] || chotBadge}">${o.giaiDoan || o.ttChotDon || 'Chờ'}</span>${(o.choBaoGia||[]).length && o.giaiDoan === 'Chờ bộ phận báo giá' ? `<span class="block text-[10px] text-amber-600 mt-1">Chờ: ${o.choBaoGia.join(', ')}</span>` : ''}${o.quaHan ? `<span class="block text-[10px] font-bold text-red-600 mt-1" title="Kiểm tra với khách và chuyển trạng thái đơn nếu cần"><i class="fas fa-exclamation-triangle mr-1"></i>${o.soNgayCho} ngày chưa chốt</span>` : ''}${((o.chungTu || {}).thieu || []).length ? `<span class="block text-[10px] text-pink-600 mt-0.5" title="Chứng từ của đơn đã chốt chưa hoàn tất"><i class="fas fa-file-contract mr-1"></i>Thiếu: ${o.chungTu.thieu.map(t => t.split(' ')[0] + ' ' + (t.split(' ')[1] || '')).join(', ')}</span>` : ''}${o.tamXuat ? `<span class="block text-[10px] text-indigo-600 mt-0.5" title="Kho đang tạm xuất vật tư cho đơn này; tự tái nhập khi đơn Không chốt hoặc Hủy">Kho giữ ${o.tamXuat} mã</span>` : ''}</td>
                <td class="px-4 py-3"><span class="px-2 py-0.5 rounded-full text-xs font-semibold ${pipelineBadge}">${o.ttDonHang||'Mới'}</span></td>
                <td class="px-4 py-3 text-right font-semibold">${gia}</td>
                <td class="px-4 py-3 text-gray-400 text-xs">${(o.ngayTao||'').slice(0,10)}</td>
                <td class="px-4 py-3 text-center" onclick="event.stopPropagation()">
                    <button onclick="openEdit(${o.id})" title="Sửa" class="text-blue-500 hover:text-blue-700 mr-2"><i class="fas fa-edit"></i></button>
                    <button onclick="reorderFrom(${o.id})" title="Đặt lại: tạo đơn mới giống đơn này" class="text-emerald-500 hover:text-emerald-700 mr-2"><i class="fas fa-redo"></i></button>
                    <button onclick="confirmDelete(${o.id},'${o.maDH}')" class="text-red-400 hover:text-red-600"><i class="fas fa-trash"></i></button>
                </td>
            </tr>`;
        }).join('');

    // Pagination
    document.getElementById('paginationBar').innerHTML = `
        <span>Hiển thị ${Math.min((currentPage-1)*PAGE_SIZE+1, total)}–${Math.min(currentPage*PAGE_SIZE, total)} / ${total} đơn</span>
        <div class="flex gap-1">
            ${currentPage > 1 ? `<button onclick="goPage(${currentPage-1})" class="px-3 py-1 border rounded hover:bg-gray-100">‹</button>` : ''}
            ${Array.from({length: totalPages}, (_,i) => `<button onclick="goPage(${i+1})" class="px-3 py-1 border rounded ${i+1===currentPage?'bg-blue-600 text-white':' hover:bg-gray-100'}">${i+1}</button>`).join('')}
            ${currentPage < totalPages ? `<button onclick="goPage(${currentPage+1})" class="px-3 py-1 border rounded hover:bg-gray-100">›</button>` : ''}
        </div>`;
}
function goPage(p) { currentPage = p; renderTable(); }

// ---- MODAL ----
function openModal() {
    document.getElementById('modalDH').style.display = 'flex';
    document.getElementById('formDH').reset();
    document.getElementById('dh_id').value = '';
    syncTabs();
    document.getElementById('dh_maDH').value = '';
    document.getElementById('folderId_hidden').value = '';
    document.getElementById('inputFolderId_hidden').value = '';
    document.getElementById('outputFolderId_hidden').value = '';
    document.getElementById('documentFolderId_hidden').value = '';
    document.getElementById('btnDelete').classList.add('hidden');
    document.getElementById('modalTitle').textContent = 'Tạo đơn hàng mới';
    document.getElementById('dh_ngayTao').value = new Date().toISOString().split('T')[0];
    document.getElementById('dh_soLuongPCB').value = 0;
    document.getElementById('dh_soLuongLK').value = 0;
    document.getElementById('dh_soLuongGiaCong').value = 0;
    document.getElementById('dh_heSoSale').value = 1;
    document.getElementById('dh_vat').value = 0;
    document.getElementById('dh_chietKhau').value = 0;
    document.getElementById('dh_tamUng').value = 0;
    document.getElementById('dh_giaThietKe').value = 0;
    document.querySelector('input[name="ttChotDon"][value="Chờ phản hồi"]').checked = true;
    updateDriveDisplay();
    updateCostDisplay(0,0,0);
    calcTongCong();
    selectedPipeline = 'Chờ báo giá';
    orderItems = [blankItem()];
    itemsLocked = false;
    servicesFromItems();
    renderOrderItems();
    document.getElementById('btnReorder').classList.add('hidden');
    onKhachHangChange();
    showQuoteWarning(null);
    updatePaymentButtons(null);
    renderDocBadges(null);
    fillSaleAndBrand(CURRENT_USER_NAME, CURRENT_USER_BRAND || (brandOptions.length === 1 ? brandOptions[0].id : null));
    document.getElementById('modalSubtitle').textContent = 'Hệ thống H-TECH ERP';
    // Trang nay chi tao 1 loai don: an lua chon loai con lai
    setOrderType(PAGE_TYPE, false);
    document.querySelectorAll('input[name="loaiDV"]').forEach(r => { const other = r.value !== PAGE_TYPE; r.disabled = other; const card = r.closest('label'); if (card) card.style.display = other ? 'none' : ''; });
    switchTab(1);
}

function openEdit(id) {
    const o = allOrders.find(x => x.id === id);
    if (!o) return;
    openModal();
    document.getElementById('dh_id').value = o.id;
    syncTabs();
    document.getElementById('dh_maDH').value = o.maDH;
    document.getElementById('modalTitle').textContent = `Đơn hàng: ${o.maDH}`;
    document.getElementById('dh_maKH').value = o.maKH || '';
    document.getElementById('dh_tenMach').value = o.tenMach || '';
    document.getElementById('dh_ngayTao').value = (o.ngayTao||'').slice(0,10);
    document.getElementById('dh_ngayChot').value = (o.ngayChot||'').slice(0,10);
    document.getElementById('dh_leadtime').value = o.leadtime || '';
    document.getElementById('dh_ngayBanGiao').value = (o.ngayBanGiao||'').slice(0,10);
    document.getElementById('dh_soLuongPCB').value = o.soLuongPCB || 0;
    document.getElementById('dh_soLuongLK').value = o.soLuongLK || 0;
    document.getElementById('dh_soLuongGiaCong').value = o.soLuongGiaCong || 0;
    document.getElementById('dh_ghiChuKyThuat').value = o.ghiChuKyThuat || '';
    document.getElementById('dh_ttQuyTrinh').value = o.ttQuyTrinh || 'Đang xử lý';
    document.getElementById('dh_noteDH').value = o.noteDH || '';
    document.getElementById('dh_driveLink').value = o.driveLink || '';
    document.getElementById('folderId_hidden').value = o.folderId || '';
    document.getElementById('inputFolderId_hidden').value = o.inputFolderId || '';
    document.getElementById('outputFolderId_hidden').value = o.outputFolderId || '';
    document.getElementById('documentFolderId_hidden').value = o.documentFolderId || '';
    document.getElementById('dh_heSoSale').value = o.heSoSale || 1;
    document.getElementById('dh_giaBao').value = o.giaBao || 0;
    document.getElementById('dh_vat').value = o.vat || 0;
    document.getElementById('dh_chietKhau').value = o.chietKhau || 0;
    document.getElementById('dh_tamUng').value = o.tamUng || 0;
    document.getElementById('dh_ngayBanGiaoThucTe').value = (o.ngayBanGiaoThucTe||'').slice(0,10);
    document.getElementById('dh_hangMucBanGiao').value = o.hangMucBanGiao || '';
    document.getElementById('dh_ttNghiemThu').value = o.ttNghiemThu || '';
    document.getElementById('dh_ttThanhToan').value = o.ttThanhToan || '';
    document.getElementById('dh_ghiChuNghiemThu').value = o.ghiChuNghiemThu || '';
    document.getElementById('dh_noiDungPhatSinh').value = o.noiDungPhatSinh || '';
    const ttChot = o.ttChotDon || 'Chờ phản hồi';
    const radioChot = document.querySelector(`input[name="ttChotDon"][value="${ttChot}"]`);
    if (radioChot) radioChot.checked = true;
    toggleLyDoHuy(ttChot);
    document.getElementById('dh_lyDoHuy').value = o.lyDoHuy || '';
    updateDriveDisplay(o.folderId, o.inputFolderId, o.outputFolderId, o.documentFolderId);
    updateCostDisplay(o.giaCostPCB||0, o.giaCostLK||0, o.giaCostGiaCong||0);
    document.getElementById('dh_giaThietKe').value = o.giaThietKe || 0;
    calcTongCong();
    selectedPipeline = o.ttDonHang || 'Chờ báo giá';
    orderItems = (o.items || []).map(it => ({ ...it }));
    if (!orderItems.length) orderItems = [blankItem()];
    itemsLocked = o.ttChotDon === 'Đã chốt';
    servicesFromItems();
    renderOrderItems();
    onKhachHangChange();
    setOrderType(o.loaiDV === 'rnd' ? 'rnd' : 'sx', true);
    document.querySelectorAll('input[name="loaiDV"]').forEach(r => { const card = r.closest('label'); if (card) card.style.display = r.checked ? '' : 'none'; });
    showQuoteWarning(o);
    updatePaymentButtons(o);
    renderDocBadges(o);
    fillSaleAndBrand(o.saleName || '', o.brandId);
    document.getElementById('modalSubtitle').textContent = 'Giai đoạn: ' + (o.giaiDoan || '');
    document.getElementById('btnDelete').classList.remove('hidden');
    document.getElementById('btnReorder').classList.remove('hidden');
}

// DAT LAI: mo form tao don MOI voi du lieu cua don cu (khach, loai mach, so luong, ghi chu...). Gia cost khong mang theo -> cac bo phan bao gia lai nhu don moi.
function reorderFrom(id) {
    const o = allOrders.find(x => x.id === (id || Number(document.getElementById('dh_id').value)));
    if (!o) return;
    openModal();
    const set = (elId, v) => { document.getElementById(elId).value = v === null || v === undefined ? '' : v; };
    set('dh_maKH', o.maKH); set('dh_tenMach', o.tenMach); set('dh_leadtime', o.leadtime); set('dh_ghiChuKyThuat', o.ghiChuKyThuat);
    set('dh_noteDH', `Đặt lại từ đơn ${o.maDH}` + (o.noteDH && !/^Đặt lại từ đơn/.test(o.noteDH) ? ' · ' + o.noteDH : ''));
    set('dh_vat', o.vat || 0); set('dh_chietKhau', o.chietKhau || 0); set('dh_heSoSale', o.heSoSale || 1);
    orderItems = (o.items || []).map(it => ({ id: null, tenMach: it.tenMach, soLuongPCB: it.soLuongPCB || 0, soLuongLK: it.soLuongLK || 0, soLuongGiaCong: it.soLuongGiaCong || 0 }));
    if (!orderItems.length) orderItems = [blankItem()];
    servicesFromItems();
    renderOrderItems();
    fillSaleAndBrand(CURRENT_USER_NAME, CURRENT_USER_BRAND || o.brandId); // don dat lai thuoc ve sale dang tao
    onKhachHangChange();
    calcTongCong();
    document.getElementById('modalTitle').textContent = `Đặt lại đơn ${o.maDH} (đơn mới)`;
    document.getElementById('modalSubtitle').textContent = 'Kiểm tra số lượng rồi bấm Lưu · các bộ phận sẽ báo giá lại';
}

function closeModal() {
    document.getElementById('modalDH').style.display = 'none';
}

// ---- THU TIEN (Sale va Ke toan deu ghi nhan duoc; tien ve TK cong ty hoac TK ca nhan) ----
function currentOrder() {
    const id = Number(document.getElementById('dh_id').value);
    return allOrders.find(x => x.id === id);
}
function updatePaymentButtons(o) {
    const canCollect = !!o && o.ttChotDon === 'Đã chốt' && o.ttQuyTrinh !== 'Hủy đơn';
    document.getElementById('btnThuTien').classList.toggle('hidden', !(canCollect && o.conNo > 0));
    document.getElementById('btnLichSuThu').classList.toggle('hidden', !canCollect);
    document.getElementById('thuTienHint').classList.toggle('hidden', canCollect);
}
function collectForCurrentOrder() {
    const o = currentOrder();
    if (!o) return;
    openCollectPayment(o, async () => { await loadAll(); openEdit(o.id); switchTab(3); });
}
function historyForCurrentOrder() {
    const o = currentOrder();
    if (o) showOrderPayments(o);
}

// ---- SALE PHU TRACH + THUONG HIEU (dung cho bao cao kinh doanh) ----
// Sale phu trach va thuong hieu di theo TAI KHOAN sale (khong chon theo tung don). Chi Admin doi duoc tren don.
const IS_ADMIN = <%= (user && user.allRoles && user.allRoles.includes('Admin')) ? 'true' : 'false' %>;
const CURRENT_USER_BRAND = <%= (user && Number(user.brandId)) || 'null' %>;
const CURRENT_USER_NAME = <%- JSON.stringify((user && user.name) || '').replace(/</g, '\\u003c') %>;
let saleOptions = [], brandOptions = [];
async function loadSaleAndBrandOptions() {
    if (saleOptions.length || brandOptions.length) return;
    try {
        const [users, brands] = await Promise.all([fetch('/api/users').then(r => r.json()), fetch('/api/settings/brands').then(r => r.json())]);
        saleOptions = (Array.isArray(users) ? users : []).filter(u => u.status !== 0 && (u.roles || []).some(r => r === 'Sale' || r === 'Admin')).map(u => u.name);
        brandOptions = Array.isArray(brands) ? brands : [];
    } catch (e) { /* khong tai duoc danh sach thi van tao don binh thuong */ }
}
function fillSaleAndBrand(saleName, brandId) {
    const names = [...new Set([...saleOptions, saleName, CURRENT_USER_NAME].filter(Boolean))];
    document.getElementById('dh_saleName').innerHTML = names.map(n => `<option value="${esc(n)}" ${n === saleName ? 'selected' : ''}>${esc(n)}</option>`).join('');
    document.getElementById('dh_brandId').innerHTML = '<option value="">— Chưa chọn —</option>' + brandOptions.map(b => `<option value="${b.id}" ${Number(brandId) === b.id ? 'selected' : ''}>${esc(b.company || b.code || ('Thương hiệu ' + b.id))}</option>`).join('');
    document.querySelectorAll('.admin-only').forEach(el => el.classList.toggle('hidden', !IS_ADMIN));
    const brand = brandOptions.find(b => b.id === Number(brandId));
    document.getElementById('ownerInfo').innerHTML = `Sale phụ trách: <b>${esc(saleName || '—')}</b> · Thương hiệu: <b>${esc(brand ? (brand.company || brand.code || '') : 'chưa gán cho tài khoản')}</b>`;
}

// ---- CHUNG TU: hop dong, hoa don, bien ban (Sale va Ke toan cung cap nhat) ----
function renderDocBadges(o) {
    const box = document.getElementById('docBadges');
    if (!o || !o.chungTu) { box.innerHTML = ''; document.getElementById('docHint').classList.remove('hidden'); return; }
    document.getElementById('docHint').classList.add('hidden');
    box.innerHTML = ['hopdong', 'po', 'hoadon', 'bienban'].map(loai => {
        const d = o.chungTu[loai];
        return `<div class="bg-white border rounded-lg p-3">
            <p class="font-semibold text-gray-600 mb-1">${esc(d.label)}</p>
            ${orderDocBadge(o, loai, 'editOrderDoc')}
            ${d.ngay ? `<span class="ml-1 text-gray-400">${esc(d.ngay)}</span>` : ''}
            ${d.link ? `<a href="${esc(d.link)}" target="_blank" class="ml-1 text-blue-600 hover:underline">Mở file</a>` : ''}
        </div>`;
    }).join('');
}
function editOrderDoc(id, loai) {
    const o = allOrders.find(x => x.id === id);
    if (!o) return;
    openOrderDocument(o, loai, docs => { o.chungTu = docs; renderDocBadges(o); renderTable(); });
}

// ---- CAC LOAI MACH CUA DON (don sx) ----
let orderItems = [];
let itemsLocked = false;
// Khach dat hang muc nao (PCB / linh kien / san xuat): hang muc khong tick -> so luong 0 -> khong vao luong bao gia / mua hang / san xuat cua bo phan do
const SERVICES = ['soLuongPCB', 'soLuongLK', 'soLuongGiaCong'];
let services = { soLuongPCB: true, soLuongLK: true, soLuongGiaCong: true };
function servicesFromItems() {
    SERVICES.forEach(f => { services[f] = orderItems.some(it => (it[f] || 0) > 0); });
    if (!SERVICES.some(f => services[f])) SERVICES.forEach(f => { services[f] = true; }); // don moi: mac dinh ca 3, Sale bo tick cai khong dat
}
function setService(f, on) {
    if (itemsLocked) return renderOrderItems();
    if (!on && SERVICES.filter(x => services[x]).length === 1) {
        Swal.fire({ icon: 'info', title: 'Cần ít nhất một hạng mục', text: 'Đơn phải có PCB, linh kiện hoặc sản xuất.' });
        return renderOrderItems();
    }
    services[f] = on;
    orderItems.forEach(it => { it[f] = on ? (it[f] || Math.max(it.soLuongPCB || 0, it.soLuongLK || 0, it.soLuongGiaCong || 0)) : 0; });
    renderOrderItems();
}
const blankItem = () => ({ id: null, tenMach: '', soLuongPCB: 0, soLuongLK: 0, soLuongGiaCong: 0, on: { soLuongPCB: true, soLuongLK: true, soLuongGiaCong: true } });

function renderOrderItems() {
    const dis = itemsLocked ? 'disabled' : '';
    const inp = 'border rounded-lg px-2 py-1 text-sm outline-none focus:ring-2 focus:ring-blue-400 disabled:bg-gray-100';
    const orderId = document.getElementById('dh_id').value, hasDrive = !!document.getElementById('inputFolderId_hidden').value;
    const FOLDER = { soLuongPCB: ['in-pcb', 'PCB'], soLuongLK: ['in-bom', 'BOM'], soLuongGiaCong: ['in-smt', 'SMT'] };
    document.getElementById('orderItemsBody').innerHTML = orderItems.map((it, i) => {
        if (!it.on) it.on = { soLuongPCB: (it.soLuongPCB || 0) > 0, soLuongLK: (it.soLuongLK || 0) > 0, soLuongGiaCong: (it.soLuongGiaCong || 0) > 0 };
        const cost = (it.giaCostPCB || 0) + (it.giaCostLK || 0) + (it.giaCostGiaCong || 0);
        const waiting = [['PCB', it.soLuongPCB, it.giaCostPCB], ['LK', it.soLuongLK, it.giaCostLK], ['SX', it.soLuongGiaCong, it.giaCostGiaCong]]
            .filter(([, q, c]) => q > 0 && !(c > 0)).map(([label]) => label);
        // Moi hang muc: o tick (khach co dat hang muc nay cho mach nay khong) + so luong
        const cell = f => `<td class="px-3 py-1 text-right whitespace-nowrap"><input type="checkbox" ${dis} ${it.on[f] ? 'checked' : ''} onchange="setItemService(${i}, '${f}', this.checked)" title="Khách có đặt hạng mục này cho mạch này" class="mr-1 align-middle">
            <input ${dis} ${it.on[f] ? '' : 'disabled'} type="number" min="0" value="${it.on[f] ? (it[f] || '') : ''}" placeholder="${it.on[f] ? 'SL' : '—'}" onchange="setOrderItem(${i}, '${f}', this.value)" class="${inp} w-20 text-right font-bold align-middle"></td>`;
        const folders = it.id && orderId && hasDrive ? SERVICES.filter(f => (it[f] || 0) > 0).map(f => `<a href="/api/orders/${orderId}/folder/${FOLDER[f][0]}?line=${it.id}" target="_blank" title="Thư mục ${FOLDER[f][1]} riêng của mạch này" class="inline-block px-2 py-0.5 mr-1 rounded border text-[11px] font-bold text-blue-700 hover:bg-blue-50"><i class="fas fa-folder-open mr-1"></i>${FOLDER[f][1]}</a>`).join('')
            : `<span class="text-[11px] text-gray-400">${it.id ? 'đơn chưa có thư mục Drive' : 'có sau khi lưu đơn'}</span>`;
        return `<tr class="border-t">
            <td class="px-3 py-1"><input ${dis} value="${esc(it.tenMach)}" onchange="setOrderItem(${i}, 'tenMach', this.value)" placeholder="VD: Mạch nguồn 12V" class="${inp} w-full min-w-[200px]"></td>
            ${cell('soLuongPCB')}${cell('soLuongLK')}${cell('soLuongGiaCong')}
            <td class="px-3 py-1 whitespace-nowrap">${folders}</td>
            <td class="px-3 py-1 text-right text-xs whitespace-nowrap">${cost > 0 ? `<b>${new Intl.NumberFormat('vi-VN').format(cost)} đ</b>` : '<span class="text-gray-300">—</span>'}${it.id && waiting.length ? `<span class="block text-amber-600">Chờ: ${waiting.join(', ')}</span>` : ''}</td>
            <td class="px-3 py-1 text-center">${itemsLocked || orderItems.length < 2 ? '' : `<button type="button" onclick="removeOrderItem(${i})" class="text-red-400 hover:text-red-600" title="Xóa loại mạch này"><i class="fas fa-trash"></i></button>`}</td>
        </tr>`;
    }).join('');
    document.getElementById('btnAddItem').classList.toggle('hidden', itemsLocked);
    document.getElementById('itemsLockedNote').classList.toggle('hidden', !itemsLocked);
    syncItemTotals();
}
// Tick / bo tick 1 hang muc cua RIENG 1 loai mach. Tick thi lay san so luong cua hang muc khac cung dong.
function setItemService(i, f, on) {
    const it = orderItems[i];
    it.on[f] = on;
    it[f] = on ? (it[f] || Math.max(it.soLuongPCB || 0, it.soLuongLK || 0, it.soLuongGiaCong || 0)) : 0;
    renderOrderItems();
}
function setOrderItem(i, key, value) {
    orderItems[i][key] = key === 'tenMach' ? value.trim() : Math.max(0, parseInt(value, 10) || 0);
    renderOrderItems();
}
function addOrderItem() { const last = orderItems[orderItems.length - 1]; const it = blankItem(); if (last && last.on) it.on = { ...last.on }; orderItems.push(it); renderOrderItems(); } // dong moi tick giong dong tren
function removeOrderItem(i) { orderItems.splice(i, 1); renderOrderItems(); }
// Tong so luong cua don = cong cac loai mach (ghi vao 3 o an de phan con lai cua form dung nhu cu)
function syncItemTotals() {
    for (const f of ['soLuongPCB', 'soLuongLK', 'soLuongGiaCong']) {
        document.getElementById('dh_' + f).value = orderItems.reduce((s, it) => s + (it[f] || 0), 0);
    }
}

// Nhac Sale khi con bo phan chua bao gia cost (chua the bao khach / chot don)
function showQuoteWarning(o) {
    const box = document.getElementById('quoteWarning');
    const waiting = o ? (o.choBaoGia || []) : null;
    const decided = o && (o.ttChotDon === 'Đã chốt' || o.ttChotDon === 'Không chốt');
    if (!o) {
        document.getElementById('quoteWarningText').textContent = 'Sau khi lưu, đơn sẽ được chuyển cho các bộ phận báo giá cost. Khi đủ báo giá, bạn nhân hệ số để ra giá báo khách.';
        box.classList.remove('hidden');
    } else if (waiting.length && !decided) {
        document.getElementById('quoteWarningText').textContent = 'Đang chờ báo giá cost từ bộ phận: ' + waiting.join(', ') + '. Chưa thể báo khách hoặc chốt đơn.';
        box.classList.remove('hidden');
    } else {
        box.classList.add('hidden');
    }
}

// ---- TABS ----
function switchTab(n) {
    [1,2,3,4].forEach(i => {
        document.getElementById(`tab-${i}`).classList.toggle('hidden', i !== n);
        const btn = document.getElementById(`tab-btn-${i}`);
        if (i === n) {
            btn.className = 'tab-btn px-4 py-2 text-sm font-semibold rounded-t-lg border border-b-0 border-blue-500 bg-blue-50 text-blue-700';
        } else {
            btn.className = 'tab-btn px-4 py-2 text-sm font-semibold rounded-t-lg text-gray-500 hover:bg-gray-50 border border-transparent';
        }
    });
    syncTabs();
}
// Don chua luu chi co buoc 1 (thong tin). Bao gia, chot don, tien do chi co sau khi don da tao.
function syncTabs() {
    const isNew = !document.getElementById('dh_id').value;
    [2, 3, 4].forEach(i => document.getElementById(`tab-btn-${i}`).classList.toggle('hidden', isNew));
    document.getElementById('newOrderHint').classList.toggle('hidden', !isNew);
}
// Leadtime (ngay) -> ngay ban giao du kien = ngay chot (chua chot thi hom nay) + leadtime
function leadtimeToDate() {
    const days = parseInt(document.getElementById('dh_leadtime').value, 10);
    if (!(days > 0)) return;
    const base = document.getElementById('dh_ngayChot').value ? new Date(document.getElementById('dh_ngayChot').value) : new Date();
    base.setDate(base.getDate() + days);
    document.getElementById('dh_ngayBanGiao').value = `${base.getFullYear()}-${String(base.getMonth() + 1).padStart(2, '0')}-${String(base.getDate()).padStart(2, '0')}`;
}

// ---- PIPELINE ----
let selectedPipeline = 'Chờ báo giá';
function renderPipelineButtons(current) {
    selectedPipeline = current || 'Chờ báo giá';
    const steps = PIPELINE_BY_TYPE[currentOrderType()].slice();
    // Don cu co trang thai khong nam trong danh sach -> van hien de khong bi mat khi luu
    if (!steps.includes(selectedPipeline)) steps.unshift(selectedPipeline);
    document.getElementById('pipelineButtons').innerHTML = steps.map(s => {
        const active = s === selectedPipeline;
        const badge = PIPELINE_BADGE[s] || 'bg-gray-100 text-gray-600';
        const base = active ? 'ring-2 ring-offset-1 ring-blue-500 ' : '';
        return `<button type="button" onclick="selectPipeline('${s}')" class="${base}${badge} rounded-lg px-3 py-2 text-xs font-bold transition border border-transparent hover:opacity-80">${s}</button>`;
    }).join('');
}
function selectPipeline(s) { selectedPipeline = s; renderPipelineButtons(s); }

// ---- COST / CALC ----
function updateCostDisplay(pcb, lk, gc) {
    const fmt = v => new Intl.NumberFormat('vi-VN').format(v||0) + ' đ';
    document.getElementById('display_costPCB').textContent = fmt(pcb);
    document.getElementById('display_costLK').textContent = fmt(lk);
    document.getElementById('display_costGC').textContent = fmt(gc);
    const total = (pcb||0) + (lk||0) + (gc||0);
    document.getElementById('display_totalCost').textContent = fmt(total);
    return total;
}

function calcGiaBao() {
    const total = currentOrderType() === 'rnd'
        ? (parseFloat(document.getElementById('dh_giaThietKe').value) || 0)
        : (parseFloat(document.getElementById('display_totalCost').textContent.replace(/[^0-9]/g,'')) || 0);
    const heso = parseFloat(document.getElementById('dh_heSoSale').value) || 1;
    document.getElementById('dh_giaBao').value = Math.round(total * heso);
    calcTongCong();
}

function calcTongCong() {
    const giaBao = parseFloat(document.getElementById('dh_giaBao').value) || 0;
    const vat = parseFloat(document.getElementById('dh_vat').value) || 0;
    const ck = parseFloat(document.getElementById('dh_chietKhau').value) || 0;
    const tong = giaBao + giaBao*vat/100 - giaBao*ck/100;
    document.getElementById('display_tongCong').textContent = new Intl.NumberFormat('vi-VN').format(Math.round(tong)) + ' đ';
}

// ---- DRIVE ----
function updateDriveDisplay(fid, iid, oid, did) {
    const setLink = (displayId, linkId, val) => {
        const el = document.getElementById(displayId);
        const lnk = document.getElementById(linkId);
        if (val) {
            el.textContent = val.slice(0,20) + '...';
            lnk.href = `https://drive.google.com/drive/folders/${val}`;
            lnk.classList.remove('hidden');
        } else {
            el.textContent = 'Chưa có';
            lnk.classList.add('hidden');
        }
    };
    // Thu muc tung bo phan trong "2. OUTPUT" (tu tao khi mo lan dau)
    let box = document.getElementById('deptFolderLinks');
    if (!box) { box = document.createElement('div'); box.id = 'deptFolderLinks'; box.className = 'mt-3 flex flex-wrap gap-2 items-center text-xs'; document.getElementById('link_documentFolderId').parentNode.parentNode.insertAdjacentElement('afterend', box); }
    const orderId = document.getElementById('dh_id').value;
    const type = (document.querySelector('input[name="loaiDV"]:checked') || document.getElementById('loaiDV') || {}).value;
    const depts = type === 'rnd' ? [['thietke', 'Thiết kế']] : [['pcb', 'PCB'], ['linhkien', 'Linh kiện'], ['sanxuat', 'Sản xuất'], ['kho', 'Kho - Giao hàng']];
    const ins = type === 'rnd' ? [['in-design', 'Design']] : [['in-bom', 'BOM'], ['in-pcb', 'PCB'], ['in-smt', 'SMT']];
    box.innerHTML = (oid && orderId) ? '<span class="font-semibold text-gray-500">Trong INPUT (yêu cầu của khách):</span>' + ins.map(d => `<a href="/api/orders/${orderId}/folder/${d[0]}" target="_blank" class="px-2 py-1 rounded-lg bg-yellow-50 text-yellow-700 border border-yellow-200 font-bold hover:bg-yellow-100"><i class="fas fa-folder mr-1"></i>${d[1]}</a>`).join('')
        + '<span class="font-semibold text-gray-500 ml-3">Trong OUTPUT (từng bộ phận):</span>' + depts.map(d => `<a href="/api/orders/${orderId}/folder/${d[0]}" target="_blank" class="px-2 py-1 rounded-lg bg-green-50 text-green-700 border border-green-200 font-bold hover:bg-green-100"><i class="fas fa-folder mr-1"></i>${d[1]}</a>`).join('') : '';
    setLink('display_folderId','link_folderId', fid);
    setLink('display_inputFolderId','link_inputFolderId', iid);
    setLink('display_outputFolderId','link_outputFolderId', oid);
    setLink('display_documentFolderId','link_documentFolderId', did);
}

function toggleLyDoHuy(val) {
    document.getElementById('lyDoHuyWrap').classList.toggle('hidden', val !== 'Không chốt');
}
document.querySelectorAll('input[name="ttChotDon"]').forEach(r => r.addEventListener('change', e => toggleLyDoHuy(e.target.value)));

// ---- SAVE ----
async function handleSaveOrder(e) {
    e.preventDefault();
    const ttChotDonEl = document.querySelector('input[name="ttChotDon"]:checked');
    const loaiDV = currentOrderType();
    const isRnd = loaiDV === 'rnd';
    const qty = id => isRnd ? 0 : (parseInt(document.getElementById(id).value) || 0);
    if (!isRnd && !itemsLocked) {
        syncItemTotals();
        const noQty = orderItems.find(it => it.on && SERVICES.some(f => it.on[f] && !((it[f] || 0) > 0)));
        if (noQty) { switchTab(1); return Swal.fire({ icon: 'warning', title: 'Thiếu số lượng', text: `Mạch "${noQty.tenMach || '(chưa đặt tên)'}": hạng mục đã tick cần có số lượng lớn hơn 0, hoặc bỏ tick.` }); }
        const bad = orderItems.find(it => !it.tenMach || (it.soLuongPCB || 0) + (it.soLuongLK || 0) + (it.soLuongGiaCong || 0) === 0);
        if (bad) {
            switchTab(1);
            return Swal.fire({ icon:'warning', title:'Thiếu thông tin loại mạch', text:'Mỗi loại mạch cần có tên và số lượng PCB, linh kiện hoặc sản xuất.' });
        }
    }
    const payload = {
        id: document.getElementById('dh_id').value || null,
        maDH: document.getElementById('dh_maDH').value || null,
        maKH: document.getElementById('dh_maKH').value,
        tenMach: document.getElementById('dh_tenMach').value,
        ngayTao: document.getElementById('dh_ngayTao').value,
        ngayChot: document.getElementById('dh_ngayChot').value,
        leadtime: document.getElementById('dh_leadtime').value,
        ngayBanGiao: document.getElementById('dh_ngayBanGiao').value,
        soLuongPCB: qty('dh_soLuongPCB'),
        soLuongLK: qty('dh_soLuongLK'),
        soLuongGiaCong: qty('dh_soLuongGiaCong'),
        giaThietKe: isRnd ? (parseFloat(document.getElementById('dh_giaThietKe').value) || 0) : 0,
        ghiChuKyThuat: document.getElementById('dh_ghiChuKyThuat').value,
        ttQuyTrinh: document.getElementById('dh_ttQuyTrinh').value,
        noteDH: document.getElementById('dh_noteDH').value,
        saleName: document.getElementById('dh_saleName').value,
        brandId: document.getElementById('dh_brandId').value || null,
        folderId: document.getElementById('folderId_hidden').value || null,
        inputFolderId: document.getElementById('inputFolderId_hidden').value || null,
        outputFolderId: document.getElementById('outputFolderId_hidden').value || null,
        documentFolderId: document.getElementById('documentFolderId_hidden').value || null,
        heSoSale: parseFloat(document.getElementById('dh_heSoSale').value) || 1,
        giaBao: parseFloat(document.getElementById('dh_giaBao').value) || 0,
        vat: parseFloat(document.getElementById('dh_vat').value) || 0,
        chietKhau: parseFloat(document.getElementById('dh_chietKhau').value) || 0,
        tamUng: parseFloat(document.getElementById('dh_tamUng').value) || 0,
        ttChotDon: ttChotDonEl ? ttChotDonEl.value : 'Chờ phản hồi',
        lyDoHuy: document.getElementById('dh_lyDoHuy').value,
        ttDonHang: selectedPipeline,
        ngayBanGiaoThucTe: document.getElementById('dh_ngayBanGiaoThucTe').value,
        hangMucBanGiao: document.getElementById('dh_hangMucBanGiao').value,
        ttNghiemThu: document.getElementById('dh_ttNghiemThu').value,
        ttThanhToan: document.getElementById('dh_ttThanhToan').value,
        ghiChuNghiemThu: document.getElementById('dh_ghiChuNghiemThu').value,
        noiDungPhatSinh: document.getElementById('dh_noiDungPhatSinh').value,
        dauViec: [],
        items: isRnd ? undefined : orderItems.map(it => ({ id: it.id, tenMach: it.tenMach, soLuongPCB: it.soLuongPCB || 0, soLuongLK: it.soLuongLK || 0, soLuongGiaCong: it.soLuongGiaCong || 0 })),
        loaiDV
    };

    try {
        const r = await fetch('/api/orders/save', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
        const result = await r.json();
        if (!result.success) throw new Error(result.error);

        if (!payload.id && result.folderId) {
            document.getElementById('folderId_hidden').value = result.folderId || '';
            document.getElementById('inputFolderId_hidden').value = result.inputFolderId || '';
            document.getElementById('outputFolderId_hidden').value = result.outputFolderId || '';
            document.getElementById('documentFolderId_hidden').value = result.documentFolderId || '';
            updateDriveDisplay(result.folderId, result.inputFolderId, result.outputFolderId, result.documentFolderId);
        }
        await Swal.fire({ icon:'success', title:'Đã lưu!', text: (result.maDH ? `Mã ĐH: ${result.maDH}` : 'Cập nhật thành công') + (result.stockNote ? ' — ' + result.stockNote : ''), timer: result.stockNote ? 3500 : 1500, showConfirmButton:false });
        closeModal();
        loadAll();
    } catch(err) {
        Swal.fire({ icon:'error', title:'Lỗi', text: err.message });
    }
}

// ---- DELETE ----
async function confirmDelete(id, maDH) {
    const result = await Swal.fire({ icon:'warning', title:`Xóa đơn ${maDH}?`, text:'Thao tác không thể hoàn tác!', showCancelButton:true, confirmButtonColor:'#ef4444', confirmButtonText:'Xóa', cancelButtonText:'Hủy' });
    if (!result.isConfirmed) return;
    const r = await fetch(`/api/orders/${id}`, { method:'DELETE' });
    const res = await r.json();
    if (res.success) { closeModal(); loadAll(); }
    else Swal.fire({ icon:'error', title:'Không xóa được', text: res.error || '' });
}
async function deleteCurrentOrder() {
    const id = document.getElementById('dh_id').value;
    const maDH = document.getElementById('dh_maDH').value;
    if (id) await confirmDelete(id, maDH);
}

// ---- PDF ----
function exportPDF() {
    const id = document.getElementById('dh_id').value;
    if (!id) { Swal.fire({ icon:'warning', title:'Chưa lưu đơn hàng', text:'Vui lòng lưu trước khi xuất PDF' }); return; }
    // Thuong hieu la lua chon khi xuat bao gia: mac dinh theo don (tai khoan sale), co the doi cho lan xuat nay
    const cur = document.getElementById('dh_brandId').value;
    if (brandOptions.length < 2) return window.open(`/api/orders/export-pdf/${id}${cur ? '?brandId=' + cur : ''}`, '_blank');
    Swal.fire({ title: 'Xuất báo giá với thương hiệu nào?', input: 'select', inputOptions: Object.fromEntries(brandOptions.map(b => [b.id, b.company || b.code])), inputValue: cur || brandOptions[0].id,
        showCancelButton: true, confirmButtonText: 'Xuất PDF', cancelButtonText: 'Hủy' }).then(r => { if (r.isConfirmed) window.open(`/api/orders/export-pdf/${id}?brandId=${r.value}`, '_blank'); });
}

// ---- CUSTOMERS CHANGE ----
// Hien thong tin khach hang da chon ngay duoi o chon
function onKhachHangChange() {
    const c = allCustomers.find(x => x.maKH === document.getElementById('dh_maKH').value);
    document.getElementById('khInfo').textContent = c ? [c.tenKH, c.sdt, c.diaChi].filter(Boolean).join(' · ') : '';
}

// ---- INIT ----
window.addEventListener('DOMContentLoaded', loadAll);
</script>
