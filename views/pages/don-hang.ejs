</main>
<script>
let currentOrders = [];
const serviceData = {
    'Thiet ke': ['Nguyên lý', 'Layout', 'Code', 'Prototype'],
    'Copy': ['Copy mạch', 'Tạo BOM', 'Vẽ lại nguyên lý', 'Code firmware']
};

// --- LOGIC GIAO DIỆN ---

function renderServiceCheckboxes(selectedItems = []) {
    const type = document.getElementById('loaiDV').value;
    const container = document.getElementById('service-checkboxes');
    container.innerHTML = '';
    const items = serviceData[type] || [];
    items.forEach(item => {
        const isChecked = selectedItems.includes(item) ? 'checked' : '';
        container.innerHTML += `
            <label class="flex items-center space-x-2 text-xs cursor-pointer hover:text-blue-600">
                <input type="checkbox" name="dv_item" value="${item}" ${isChecked} class="rounded text-blue-600">
                <span>${item}</span>
            </label>`;
    });
}

function updateMaDH() {
    const dateVal = document.getElementById('ngayTao').value;
    const datePart = dateVal ? dateVal.split('-').join('').slice(2) : 'YYMMDD';
    const khPart = document.getElementById('maKH').value || 'KH';
    const machPart = document.getElementById('tenMach').value.toUpperCase().replace(/[^A-Z0-9]/g, '').substring(0,8) || 'MACH';
    const code = `${datePart}_${khPart}_${machPart}`;
    document.getElementById('previewMaDH').innerText = code;
    return code;
}

function calculateDeadline() {
    const ngayChotVal = document.getElementById('ngayChot').value;
    const lead = parseInt(document.getElementById('leadtime').value) || 0;
    if(ngayChotVal) {
        let d = new Date(ngayChotVal);
        d.setDate(d.getDate() + lead);
        document.getElementById('ngayBanGiao').value = d.toISOString().split('T')[0];
    }
}

function updateGiaBao() {
    const giaTK = parseFloat(document.getElementById('giaThietKe').value) || 0;
    const hs = parseFloat(document.getElementById('heSoSale').value) || 1;
    const vat = parseFloat(document.getElementById('vat').value) || 0;
    const ck = parseFloat(document.getElementById('chietKhau').value) || 0;

    let sub = giaTK * hs;
    let final = sub + (sub * vat / 100) - (sub * ck / 100);
    document.getElementById('previewGiaBao').innerText = new Intl.NumberFormat('vi-VN').format(Math.round(final)) + ' VNĐ';
    return final;
}

async function populateCustomers() {
    try {
        const res = await fetch('/api/customers');
        const customers = await res.json();
        const select = document.getElementById('maKH');
        select.innerHTML = customers.map(kh => `<option value="${kh.maKH}">${kh.maKH} - ${kh.tenKH}</option>`).join('');
        updateMaDH();
    } catch (e) { console.error("Lỗi load KH:", e); }
}

function closeModal() { document.getElementById('modalDH').classList.add('hidden'); }

// --- LOGIC DỮ LIỆU (API) ---

async function renderTable() {
    renderServiceCheckboxes();
    try {
        const response = await fetch('/api/orders');
        currentOrders = await response.json();
        const tbody = document.getElementById('order-tbody');
        const keyword = document.getElementById('filterSearch').value.toLowerCase();
        const status = document.getElementById('filterStatus').value;
        const payFilter = document.getElementById('filterPayment').value;
        
        tbody.innerHTML = '';
        currentOrders.filter(o => {
    const keyword = document.getElementById('filterSearch').value.toLowerCase();
    const status = document.getElementById('filterStatus').value;
    
    const matchesSearch = o.maDH.toLowerCase().includes(keyword) || o.tenMach.toLowerCase().includes(keyword);
    
    // Logic lọc trạng thái thông minh: Kiểm tra cả 2 cột
    const matchesStatus = (status === 'Tất cả') || 
                          (o.ttChotDon === status) || 
                          (o.ttQuyTrinh === status);

    const congNo = o.giaBao - o.tamUng;
    const matchesPay = (payFilter === 'Tất cả') || 
                       (payFilter === 'Còn nợ' && congNo > 0) || 
                       (payFilter === 'Thu đủ' && congNo <= 0);

    return matchesSearch && matchesStatus && matchesPay;
}).forEach(o => {
            const congNo = o.giaBao - o.tamUng;
    
    // ĐỊNH NGHĨA MÀU SẮC CHO TRẠNG THÁI SALE (ttChotDon)
    const chotDonColor = o.ttChotDon === 'Đã chốt' ? 'bg-green-100 text-green-700' : 
                         (o.ttChotDon === 'Không chốt' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700');

    // ĐỊNH NGHĨA MÀU SẮC CHO TRẠNG THÁI QUẢN LÝ (ttQuyTrinh)
    const quyTrinhColor = o.ttQuyTrinh === 'Đã báo giá' ? 'bg-purple-100 text-purple-700' :
                          (o.ttQuyTrinh === 'Hủy đơn' ? 'bg-slate-200 text-slate-700' : 'bg-orange-100 text-orange-700');

    const tr = document.createElement('tr');
    tr.className = 'border-b hover:bg-gray-50 transition-colors';
    tr.innerHTML = `
        <td class="p-4 font-mono text-blue-700 font-bold text-xs">${o.maDH}</td>
        <td class="p-4">
            <div class="text-xs font-bold uppercase text-slate-700">${o.loaiDV}</div>
            <div class="text-[10px] text-slate-400 font-medium">${o.tenMach}</div>
        </td>
        <td class="p-4 text-[10px] text-gray-400 max-w-[150px] truncate">
            ${Array.isArray(o.dauViec) ? o.dauViec.join(', ') : o.dauViec}
        </td>
        <td class="p-4 text-[10px] font-medium text-gray-500">${o.ngayTao}</td>
        
        <td class="p-4">
            <div class="flex flex-col gap-1">
                <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase w-fit ${chotDonColor}">
                    SALE: ${o.ttChotDon || 'Mới tạo'}
                </span>
                <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase w-fit ${quyTrinhColor}">
                    QL: ${o.ttQuyTrinh || 'Review'}
                </span>
                ${o.ttQuyTrinh === 'Hủy đơn' ? `<span class="text-[8px] text-red-400 italic font-medium">Lý do: ${o.lyDoHuy || 'N/A'}</span>` : ''}
            </div>
        </td>

        <td class="p-4">
            <div class="flex items-center gap-2">
                <span class="text-[9px] font-bold uppercase text-gray-400 italic">${o.ttThietKe || 'Chờ...'}</span>
                ${o.inputFolderId ? `
                    <a href="https://drive.google.com/drive/folders/${o.inputFolderId}" target="_blank" class="text-blue-500 hover:text-blue-700">
                        <i class="fab fa-google-drive"></i>
                    </a>
                ` : ''}
            </div>
        </td>
        <td class="p-4 text-right font-bold text-slate-600">${new Intl.NumberFormat('vi-VN').format(o.tamUng)}</td>
        <td class="p-4 text-right font-black ${congNo > 0 ? 'text-red-500' : 'text-green-600'}">
            ${new Intl.NumberFormat('vi-VN').format(congNo)}
        </td>
        <td class="p-4 text-center">
            <div class="flex justify-center gap-1">
                <button onclick="exportQuote(${o.id})" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition" title="Báo giá">
                    <i class="fas fa-file-pdf"></i>
                </button>
                <button onclick="openModal(${o.id})" class="text-yellow-500 hover:bg-yellow-50 p-2 rounded-lg transition" title="Sửa">
                    <i class="fas fa-edit"></i>
                </button>
                <button onclick="deleteOrder(${o.id})" class="text-red-300 hover:text-red-500 p-2 rounded-lg transition" title="Xóa">
                    <i class="fas fa-trash"></i>
                </button>
            </div>
        </td>`;
    tbody.appendChild(tr);
        });
    } catch (e) { console.error("Lỗi load table:", e); }
}

async function handleSaveOrder(e) {
    e.preventDefault();

    // Hiển thị Loading chuyên nghiệp
    Swal.fire({
        title: 'Đang xử lý...',
        html: 'Đang lưu đơn và khởi tạo cấu trúc thư mục Drive mẫu...',
        allowOutsideClick: false,
        didOpen: () => { Swal.showLoading(); }
    });

    const checkedItems = Array.from(document.querySelectorAll('input[name="dv_item"]:checked')).map(cb => cb.value);
    
    const data = {
        id: document.getElementById('dh_id').value || null,
        maDH: document.getElementById('previewMaDH').innerText,
        maKH: document.getElementById('maKH').value,
        tenMach: document.getElementById('tenMach').value,
        loaiDV: document.getElementById('loaiDV').value,
        dauViec: checkedItems,
        ngayTao: document.getElementById('ngayTao').value,
        ngayChot: document.getElementById('ngayChot').value,
        leadtime: parseInt(document.getElementById('leadtime').value) || 0,
        ngayBanGiao: document.getElementById('ngayBanGiao').value,
        ttQuyTrinh: document.getElementById('ttQuyTrinh').value,
        giaThietKe: parseFloat(document.getElementById('giaThietKe').value) || 0,
        heSoSale: parseFloat(document.getElementById('heSoSale').value) || 1,
        vat: parseFloat(document.getElementById('vat').value) || 0,
        chietKhau: parseFloat(document.getElementById('chietKhau').value) || 0,
        noteDH: document.getElementById('noteDH').value,
        giaBao: updateGiaBao(),
        tamUng: parseFloat(document.getElementById('tamUng').value) || 0,
        ttChotDon: document.getElementById('ttChotDon').value,
        ttQuyTrinh: document.getElementById('ttQuyTrinh').value,
        lyDoHuy: document.getElementById('lyDoHuy').value,
        // Gửi kèm ID cũ nếu có
        folderId: document.getElementById('folderId_hidden')?.value,
        inputFolderId: document.getElementById('inputFolderId_hidden')?.value,
        outputFolderId: document.getElementById('outputFolderId_hidden')?.value
        
    };

    try {
        const response = await fetch('/api/orders/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        const res = await response.json();

        if (res.success) {
            // Cập nhật lại Link vào hidden để nút bấm có tác dụng ngay mà không cần tải lại trang
            document.getElementById('inputFolderId_hidden').value = res.inputFolderId;
            document.getElementById('outputFolderId_hidden').value = res.outputFolderId;

    // Cập nhật link trực tiếp vào nút bấm
    const btnIn = document.getElementById('btnOpenInput');
    const btnOut = document.getElementById('btnOpenOutput');
    
    if (res.inputFolderId) {
        btnIn.href = `https://drive.google.com/drive/folders/${res.inputFolderId}`;
        btnIn.classList.remove('opacity-20', 'pointer-events-none');
    }
    if (res.outputFolderId) {
        btnOut.href = `https://drive.google.com/drive/folders/${res.outputFolderId}`;
        btnOut.classList.remove('opacity-20', 'pointer-events-none');
    }

            Swal.fire({
                icon: 'success',
                title: 'Hoàn tất!',
                text: 'Folder đơn hàng và file requirements đã sẵn sàng.',
                showConfirmButton: true,
                confirmButtonText: 'Mở Folder Input ngay'
            }).then((result) => {
                if (result.isConfirmed) {
                    openDriveFolder('input');
                }
            });
            
            renderTable();
        } else {
            Swal.fire("Lỗi", res.error, "error");
        }
    } catch (err) {
        Swal.fire("Lỗi hệ thống", "Kết nối server thất bại", "error");
    }
}

function editOrder(id) {
    const order = currentOrders.find(o => o.id === id);
    if (!order) return;

    // 1. Đổ dữ liệu vào các ô input (giữ nguyên các phần cũ của bạn)
    document.getElementById('dh_id').value = order.id;
    document.getElementById('maKH').value = order.maKH;
    document.getElementById('tenMach').value = order.tenMach;
    // ... các trường khác ...

    // 2. Gán giá trị vào các ô Hidden (Để khi Save không bị mất link trên DB)
    document.getElementById('folderId_hidden').value = order.folderId || '';
    document.getElementById('inputFolderId_hidden').value = order.inputFolderId || '';
    document.getElementById('outputFolderId_hidden').value = order.outputFolderId || '';

    // 3. CẬP NHẬT LINK CHO NÚT BẤM (FIX LỖI MẤT LINK)
    const btnIn = document.getElementById('btnOpenInput');
    const btnOut = document.getElementById('btnOpenOutput');

    if (order.inputFolderId && order.inputFolderId !== 'null') {
        // Nếu có ID, gắn link và hiện nút
        btnIn.href = `https://drive.google.com/drive/folders/${order.inputFolderId}`;
        btnIn.classList.remove('opacity-20', 'pointer-events-none');
    } else {
        // Nếu không có, làm mờ nút
        btnIn.href = "#";
        btnIn.classList.add('opacity-20', 'pointer-events-none');
    }

    if (order.outputFolderId && order.outputFolderId !== 'null') {
        btnOut.href = `https://drive.google.com/drive/folders/${order.outputFolderId}`;
        btnOut.classList.remove('opacity-20', 'pointer-events-none');
    } else {
        btnOut.href = "#";
        btnOut.classList.add('opacity-20', 'pointer-events-none');
    }

    openModal(); // Cuối cùng mới mở Modal
}

function addNewOrder() {
    document.getElementById('formOrder').reset();
    document.getElementById('dh_id').value = ''; // Xóa ID
    document.getElementById('folderId_hidden').value = '';
    document.getElementById('inputFolderId_hidden').value = '';
    document.getElementById('outputFolderId_hidden').value = '';
    document.getElementById('previewMaDH').innerText = 'DH-' + Date.now(); // Tạo mã mới
    openModal();
}

// Hàm phụ để cập nhật link nút bấm Drive ngay khi mở Modal sửa
function updateDriveButtons(inputID, outputID) {
    const btnIn = document.getElementById('btnOpenInput');
    const btnOut = document.getElementById('btnOpenOutput');

    if (inputID && inputID !== 'null') {
        btnIn.onclick = () => window.open(`https://drive.google.com/drive/folders/${inputID}`, '_blank');
        btnIn.classList.remove('opacity-20', 'pointer-events-none');
    } else {
        btnIn.onclick = () => Swal.fire("Thông báo", "Đơn cũ chưa có Folder Input", "info");
        btnIn.classList.add('opacity-20');
    }

    if (outputID && outputID !== 'null') {
        btnOut.onclick = () => window.open(`https://drive.google.com/drive/folders/${outputID}`, '_blank');
        btnOut.classList.remove('opacity-20', 'pointer-events-none');
    } else {
        btnOut.classList.add('opacity-20');
    }
}

// Hàm mở folder
function openDriveFolder(type) {
    const id = type === 'input' 
        ? document.getElementById('inputFolderId_hidden').value 
        : document.getElementById('outputFolderId_hidden').value;

    if (!id || id === 'null') {
        Swal.fire("Thông báo", "Thư mục này chưa được khởi tạo cho đơn hàng cũ.", "info");
        return;
    }
    window.open(`https://drive.google.com/drive/folders/${id}`, '_blank');
}

async function deleteOrder(id) {
    if(!confirm("Xác nhận xóa?")) return;
    try {
        const response = await fetch(`/api/orders/${id}`, { method: 'DELETE' });
        const res = await response.json();
        if(res.success) renderTable();
    } catch (e) { alert("Lỗi khi xóa!"); }
}



// 1. Cập nhật hàm mở Modal để hiển thị trạng thái thiết kế
function openModal(id = null) {
    populateBrands();
    document.getElementById('modalDH').classList.remove('hidden');
    
    // Lấy các element link và hidden
    const btnIn = document.getElementById('btnOpenInput');
    const btnOut = document.getElementById('btnOpenOutput');
    const hiddenIn = document.getElementById('inputFolderId_hidden');
    const hiddenOut = document.getElementById('outputFolderId_hidden');

    if(id) {
        // --- LOGIC SỬA ĐƠN ---
        const o = currentOrders.find(x => x.id == id);
        if(!o) return;

        document.getElementById('ttChotDon').value = o.ttChotDon || 'Mới khởi tạo';
        document.getElementById('ttQuyTrinh').value = o.ttQuyTrinh || 'Đang review';
        document.getElementById('lyDoHuy').value = o.lyDoHuy || '';
        
        document.getElementById('dh_id').value = o.id;
        document.getElementById('loaiDV').value = o.loaiDV;
        document.getElementById('maKH').value = o.maKH;
        document.getElementById('tenMach').value = o.tenMach;
        document.getElementById('ngayTao').value = o.ngayTao;
        document.getElementById('ngayChot').value = o.ngayChot;
        document.getElementById('leadtime').value = o.leadtime;
        document.getElementById('giaThietKe').value = o.giaThietKe;
        document.getElementById('heSoSale').value = o.heSoSale;
        document.getElementById('vat').value = o.vat || 0;
        document.getElementById('chietKhau').value = o.chietKhau || 0;
        document.getElementById('tamUng').value = o.tamUng || 0;
        document.getElementById('noteDH').value = o.noteDH || '';
        
        hiddenIn.value = o.inputFolderId || '';
        hiddenOut.value = o.outputFolderId || '';

        // Cập nhật Folder INPUT
        if (o.inputFolderId && o.inputFolderId !== 'null') {
            btnIn.href = `https://drive.google.com/drive/folders/${o.inputFolderId}`;
            btnIn.classList.remove('opacity-20', 'pointer-events-none');
        } else {
            btnIn.href = "#";
            btnIn.classList.add('opacity-20', 'pointer-events-none');
        }

        // Cập nhật Folder OUTPUT (Sửa lỗi dẫn đến folder INPUT)
        if (o.outputFolderId && o.outputFolderId !== 'null') {
            btnOut.href = `https://drive.google.com/drive/folders/${o.outputFolderId}`;
            btnOut.classList.remove('opacity-20', 'pointer-events-none');
        } else {
            btnOut.href = "#";
            btnOut.classList.add('opacity-20', 'pointer-events-none');
        }

        const viewTK = document.getElementById('viewTTThietKe');
        viewTK.innerText = o.ttThietKe || "Chờ triển khai";
        viewTK.className = `text-xs font-black uppercase ${o.ttThietKe === 'Đã hoàn thành' ? 'text-green-600' : 'text-blue-500'}`;
        
        renderServiceCheckboxes(o.dauViec);
    } else {
        // --- LOGIC THÊM MỚI ---
        // 1. Lưu lại giá trị maKH hiện tại (do window.onload gán vào trước đó)
        const savedMaKH = document.getElementById('maKH').value;

        document.getElementById('formDH').reset();
        
        // 2. Sau khi reset, gán lại mã KH nếu có
        if (savedMaKH) {
            document.getElementById('maKH').value = savedMaKH;
        }

        document.getElementById('dh_id').value = '';
        hiddenIn.value = '';
        hiddenOut.value = '';
        btnIn.classList.add('opacity-20', 'pointer-events-none');
        btnOut.classList.add('opacity-20', 'pointer-events-none');
        document.getElementById('ngayTao').valueAsDate = new Date();
        document.getElementById('viewTTThietKe').innerText = "Chưa có đơn";
        
        // Set mặc định cho đơn mới
        document.getElementById('ttChotDon').value = 'Mới khởi tạo';
        document.getElementById('ttQuyTrinh').value = 'Đang review';
        
        renderServiceCheckboxes();
    }
    
    toggleCancelNote();
    updateMaDH();
    calculateDeadline();
    updateGiaBao();
}

// 2. Hàm Báo giá nhanh
function exportQuote(id = null) {
    const finalId = id || document.getElementById('dh_id').value;
    const brandId = document.getElementById('selectBrand').value || 1;

    if (!finalId) {
        Swal.fire("Chú ý", "Vui lòng lưu đơn trước khi xem báo giá!", "warning");
        return;
    }

    // Gửi kèm tham số brandId qua Query String
    const url = `/api/orders/export-pdf/${finalId}?brandId=${brandId}`;
    window.open(url, '_blank');
}

