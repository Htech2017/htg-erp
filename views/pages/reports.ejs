<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<main class="flex-1 p-8 overflow-y-auto bg-gray-50 custom-scrollbar">
    <div class="max-w-[1600px] mx-auto">
        
        <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100 mb-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <div>
                <h1 class="text-2xl font-black text-gray-800 uppercase tracking-tight">Báo cáo & Thống kê</h1>
                <p class="text-sm text-gray-500 font-medium">Doanh thu, Công nợ & Phân bổ thưởng</p>
            </div>
            
            <div class="flex items-center gap-3 bg-gray-50 p-2 rounded-2xl border border-gray-200">
                <select id="filterType" onchange="updateFilterInputs()" class="bg-white border-gray-200 rounded-xl p-2 text-sm font-bold text-gray-700 outline-none">
                    <option value="month">Theo Tháng</option>
                    <option value="quarter">Theo Quý</option>
                    <option value="year">Theo Năm</option>
                </select>
                
                <div id="inputContainer" class="flex items-center gap-2">
                    <input type="month" id="filterMonth" class="bg-white border border-gray-200 rounded-xl p-2 text-sm font-bold text-gray-700 outline-none">
                </div>
                
                <button onclick="loadReport()" class="bg-blue-600 text-white px-6 py-2 rounded-xl font-bold shadow-md hover:bg-blue-700 transition">
                    <i class="fas fa-search mr-2"></i>Xem
                </button>
            </div>
        </div>

        <!-- ===== CHI SO CHINH CUA KY ===== -->
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
            <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Doanh thu đã chốt</p>
                <p id="kpiRevenue" class="text-2xl font-black text-slate-800 mt-1">0 đ</p>
                <p class="text-[11px] text-gray-400 mt-1">Tổng giá trị báo giá: <span id="lblTotalRev">0 đ</span></p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Lợi nhuận gộp</p>
                <p id="kpiProfit" class="text-2xl font-black text-slate-800 mt-1">0 đ</p>
                <p class="text-[11px] text-gray-400 mt-1">Biên lợi nhuận: <span id="kpiMargin">—</span></p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Tỷ lệ chốt đơn</p>
                <p id="kpiWinRate" class="text-2xl font-black text-slate-800 mt-1">—</p>
                <p class="text-[11px] text-gray-400 mt-1"><span id="kpiOrders">0 / 0</span> đơn báo giá</p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Đã thu</p>
                <p id="kpiCollected" class="text-2xl font-black text-slate-800 mt-1">0 đ</p>
                <p class="text-[11px] text-gray-400 mt-1">trên các đơn đã chốt trong kỳ</p>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
                <p class="text-[10px] font-bold text-gray-400 uppercase tracking-wider">Khách còn nợ</p>
                <p id="lblTotalDebt" class="text-2xl font-black text-slate-800 mt-1">0 đ</p>
                <p class="text-[11px] text-gray-400 mt-1"><a href="#" onclick="switchReportTab('debt'); return false;" class="text-blue-600 hover:underline">Xem theo khách hàng</a></p>
            </div>
        </div>

        <!-- ===== TAB: moi lan chi xem 1 nhom thong tin ===== -->
        <div class="flex flex-wrap justify-between items-center gap-3 mb-5">
            <div id="reportTabs" class="flex flex-wrap gap-1 bg-gray-200 p-1 rounded-xl">
                <button data-tab="overview" onclick="switchReportTab('overview')" class="rtab px-4 py-2 text-xs font-bold rounded-lg">Tổng quan</button>
                <button data-tab="dept" onclick="switchReportTab('dept')" class="rtab px-4 py-2 text-xs font-bold rounded-lg">Theo bộ phận</button>
                <button data-tab="sale" onclick="switchReportTab('sale')" class="rtab px-4 py-2 text-xs font-bold rounded-lg">Theo Sale</button>
                <button data-tab="brand" onclick="switchReportTab('brand')" class="rtab px-4 py-2 text-xs font-bold rounded-lg">Theo thương hiệu</button>
                <button data-tab="debt" onclick="switchReportTab('debt')" class="rtab px-4 py-2 text-xs font-bold rounded-lg">Công nợ</button>
                <button data-tab="bonus" onclick="switchReportTab('bonus')" class="rtab px-4 py-2 text-xs font-bold rounded-lg">Thưởng</button>
