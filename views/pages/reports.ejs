<script>
let currentReportData = null;
let currentBonusList = [];
let currentPeriodStr = '';

window.onload = () => {
    const today = new Date();
    document.getElementById('filterMonth').value = `${today.getFullYear()}-${(today.getMonth() + 1).toString().padStart(2, '0')}`;
    loadReport();
};

function formatVND(num) { return new Intl.NumberFormat('vi-VN').format(Math.round(num || 0)) + ' đ'; }

function updateFilterInputs() {
    // Tương tự code cũ để tạo thẻ input chọn Tháng/Quý/Năm
    const type = document.getElementById('filterType').value;
    const container = document.getElementById('inputContainer');
    const today = new Date();
    const yyyy = today.getFullYear();
    if (type === 'month') container.innerHTML = `<input type="month" id="filterMonth" value="${yyyy}-${(today.getMonth() + 1).toString().padStart(2, '0')}" class="bg-white border border-gray-200 rounded-xl p-2 text-sm font-bold text-gray-700 outline-none">`;
    else if (type === 'quarter') container.innerHTML = `<select id="filterQuarter" class="bg-white border rounded-xl p-2 text-sm font-bold"><option value="1">Quý 1</option><option value="2">Quý 2</option><option value="3">Quý 3</option><option value="4">Quý 4</option></select><input type="number" id="filterYear" value="${yyyy}" class="w-24 bg-white border rounded-xl p-2 text-sm font-bold">`;
    else container.innerHTML = `<input type="number" id="filterYear" value="${yyyy}" class="w-32 bg-white border rounded-xl p-2 text-sm font-bold">`;
}

function getDateRange() {
    const type = document.getElementById('filterType').value;
    let startDate, endDate, titleStr;
    if (type === 'month') {
        const val = document.getElementById('filterMonth').value;
        startDate = `${val}-01`; endDate = `${val}-${new Date(val.split('-')[0], val.split('-')[1], 0).getDate()}`;
        titleStr = `Tháng ${val.split('-')[1]}/${val.split('-')[0]}`;
    } else if (type === 'quarter') {
        const q = parseInt(document.getElementById('filterQuarter').value), y = document.getElementById('filterYear').value;
        startDate = `${y}-${((q - 1) * 3 + 1).toString().padStart(2, '0')}-01`;
        endDate = `${y}-${(q * 3).toString().padStart(2, '0')}-${new Date(y, q * 3, 0).getDate()}`;
        titleStr = `Quý ${q}/${y}`;
    } else {
        const y = document.getElementById('filterYear').value;
        startDate = `${y}-01-01`; endDate = `${y}-12-31`; titleStr = `Năm ${y}`;
    }
    return { startDate, endDate, titleStr };
}

async function loadReport() {
    const { startDate, endDate } = getDateRange();
    Swal.fire({ title: 'Đang tổng hợp...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    try {
        const res = await fetch(`/api/reports/data?startDate=${startDate}&endDate=${endDate}`);
        const data = await res.json();
        if (data.success) {
            currentReportData = data;
            document.getElementById('lblTotalRev').innerText = formatVND(data.summary.totalRevenue);
            document.getElementById('lblTotalDebt').innerText = formatVND(data.summary.totalDebt);
            document.getElementById('designerTbody').innerHTML = data.designerRevenues.map(nv => `<tr class="border-b"><td class="p-4 font-bold">${nv.name}</td><td class="p-4 text-center text-blue-600 font-bold">${nv.projectCount}</td><td class="p-4 text-right text-emerald-600 font-bold">${formatVND(nv.revenue)}</td></tr>`).join('');
            document.getElementById('debtTbody').innerHTML = data.customerDebts.map(kh => `<tr class="border-b"><td class="p-4 font-bold">${kh.tenKH}</td><td class="p-4 text-xs">${kh.sdt||'--'}</td><td class="p-4 text-right text-red-600 font-bold">${formatVND(kh.debtAmount)}</td></tr>`).join('');
            renderBusiness(data);
            renderOverview(data);
            Swal.close();
        } else {
            Swal.fire('Lỗi', data.error || 'Lỗi lấy số liệu', 'error');
        }
    } catch (err) { Swal.fire('Lỗi', 'Lỗi lấy số liệu', 'error'); }
}

// ----- Tab: moi lan chi hien 1 nhom thong tin; nho tab dang xem khi doi ky bao cao -----
let currentReportTab = 'overview';
function switchReportTab(tab) {
    currentReportTab = tab;
    document.querySelectorAll('.rpane').forEach(p => p.classList.toggle('hidden', p.id !== 'rtab-' + tab));
    document.querySelectorAll('.rtab').forEach(b => {
        const on = b.dataset.tab === tab;
        b.classList.toggle('bg-white', on); b.classList.toggle('shadow-sm', on); b.classList.toggle('text-blue-700', on);
        b.classList.toggle('text-gray-500', !on);
    });
}

// ----- Tong quan: chi so chinh + 3 bieu do thanh ngang (1 mau, do dai = doanh thu) -----
function renderOverview(data) {
    const n = v => new Intl.NumberFormat('vi-VN').format(Math.round(v || 0));
    const short = v => v >= 1e9 ? (v / 1e9).toFixed(v >= 1e10 ? 0 : 1).replace('.', ',') + ' tỷ' : v >= 1e6 ? (v / 1e6).toFixed(v >= 1e8 ? 0 : 1).replace('.', ',') + ' tr' : n(v);
    const sales = data.bySale || [];
    const sum = k => sales.reduce((s, r) => s + (r[k] || 0), 0);
    const revenue = sum('revenue'), profit = sum('profit'), quoted = sum('quoted'), orders = sum('orders');
    document.getElementById('kpiRevenue').textContent = n(revenue) + ' đ';
    document.getElementById('kpiProfit').textContent = n(profit) + ' đ';
    document.getElementById('kpiMargin').textContent = revenue > 0 ? (Math.round(profit / revenue * 1000) / 10 + '%').replace('.', ',') : '—';
    document.getElementById('kpiWinRate').textContent = quoted > 0 ? (Math.round(orders / quoted * 1000) / 10 + '%').replace('.', ',') : '—';
    document.getElementById('kpiOrders').textContent = `${n(orders)} / ${n(quoted)}`;
    document.getElementById('kpiCollected').textContent = n(sum('collected')) + ' đ';

    const bars = (id, rows, limit) => {
        const box = document.getElementById(id);
        const list = rows.filter(r => r.revenue > 0);
        if (!list.length) { box.innerHTML = '<p class="text-xs text-gray-400 italic py-6 text-center">Chưa có đơn chốt trong kỳ</p>'; return; }
        const shown = list.slice(0, limit);
        const max = Math.max(...shown.map(r => r.revenue));
        box.innerHTML = shown.map(r => `
            <div class="mb-3" title="${esc(r.label)}\nDoanh thu: ${n(r.revenue)} đ\nCost: ${n(r.cost)} đ\nLợi nhuận gộp: ${n(r.profit)} đ (${String(r.margin).replace('.', ',')}%)\nĐơn chốt: ${r.orders} / ${r.quoted} báo giá">
                <div class="flex justify-between items-baseline gap-2 text-xs mb-1">
                    <span class="text-slate-700 truncate">${esc(r.label)}</span>
                    <span class="text-slate-800 font-bold whitespace-nowrap">${short(r.revenue)}</span>
                </div>
                <div class="h-2 bg-slate-100 rounded-full"><div class="h-2 rounded-full bg-blue-600" style="width:${Math.max(2, r.revenue / max * 100)}%"></div></div>
                <p class="text-[10px] text-gray-400 mt-1">Lợi nhuận ${short(r.profit)} · biên ${String(r.margin).replace('.', ',')}% · ${r.orders} đơn chốt</p>
            </div>`).join('') + (list.length > limit ? `<p class="text-[11px] text-gray-400">và ${list.length - limit} dòng khác trong tab chi tiết</p>` : '');
    };
    bars('barsDept', data.byDept || [], 4);
    bars('barsSale', sales, 6);
    bars('barsBrand', data.byBrand || [], 6);
    switchReportTab(currentReportTab);
}

// ----- Bao cao kinh doanh theo bo phan / Sale / thuong hieu -----
const BIZ_TABLES = [
    { key: 'byDept', head: 'bizHeadDept', body: 'bizDept', first: 'Bộ phận', money: false, sheet: 'Theo_bo_phan' },
    { key: 'bySale', head: 'bizHeadSale', body: 'bizSale', first: 'Sale', money: true, sheet: 'Theo_Sale' },
    { key: 'byBrand', head: 'bizHeadBrand', body: 'bizBrand', first: 'Thương hiệu', money: true, sheet: 'Theo_thuong_hieu' }
];
function renderBusiness(data) {
    const n = v => new Intl.NumberFormat('vi-VN').format(v || 0);
    for (const t of BIZ_TABLES) {
        const rows = data[t.key] || [];
        document.getElementById(t.head).innerHTML = `<tr class="bg-slate-50 text-[10px] font-black text-slate-500 uppercase border-b">
            <th class="p-4">${t.first}</th><th class="p-4 text-center">Đơn báo giá</th><th class="p-4 text-center">Đơn chốt</th><th class="p-4 text-center">Tỷ lệ chốt</th>
            <th class="p-4 text-right">Doanh thu</th><th class="p-4 text-right">Cost</th><th class="p-4 text-right">Lợi nhuận gộp</th><th class="p-4 text-center">Biên LN</th>
            ${t.money ? '<th class="p-4 text-right">Đã thu</th><th class="p-4 text-right">Còn nợ</th>' : '<th class="p-4">Hoạt động trong kỳ</th>'}</tr>`;
        const total = rows.reduce((s, r) => ({ quoted: s.quoted + r.quoted, orders: s.orders + r.orders, revenue: s.revenue + r.revenue, cost: s.cost + r.cost, profit: s.profit + r.profit, collected: s.collected + (r.collected || 0), debt: s.debt + (r.debt || 0) }),
            { quoted: 0, orders: 0, revenue: 0, cost: 0, profit: 0, collected: 0, debt: 0 });
        const line = (r, bold) => `<tr class="border-b ${bold ? 'bg-slate-50 font-black' : ''}">
            <td class="p-4 font-bold">${esc(r.label)}</td><td class="p-4 text-center">${n(r.quoted)}</td><td class="p-4 text-center text-blue-600 font-bold">${n(r.orders)}</td>
            <td class="p-4 text-center">${bold ? '' : r.winRate + '%'}</td>
            <td class="p-4 text-right font-bold">${n(r.revenue)}</td><td class="p-4 text-right text-gray-500">${n(r.cost)}</td>
            <td class="p-4 text-right font-bold ${r.profit < 0 ? 'text-red-600' : 'text-emerald-600'}">${n(r.profit)}</td>
            <td class="p-4 text-center">${r.revenue > 0 ? Math.round(r.profit / r.revenue * 1000) / 10 + '%' : '—'}</td>
            ${t.money ? `<td class="p-4 text-right text-emerald-600">${n(r.collected)}</td><td class="p-4 text-right text-red-600">${n(Math.max(0, r.debt))}</td>` : `<td class="p-4 text-xs text-gray-500">${esc(r.extra || '')}</td>`}</tr>`;
        document.getElementById(t.body).innerHTML = rows.length
            ? rows.map(r => line(r, false)).join('') + (t.key === 'byDept' ? '' : line({ label: 'Tổng', ...total }, true))
            : '<tr><td colspan="10" class="p-8 text-center text-gray-300 italic">Không có đơn hàng trong kỳ</td></tr>';
    }
}
function exportBusinessExcel() {
    if (!currentReportData || !currentReportData.byDept) return Swal.fire('Chú ý', 'Hãy bấm Xem để lấy số liệu trước.', 'warning');
    const wb = XLSX.utils.book_new();
    for (const t of BIZ_TABLES) {
        const rows = (currentReportData[t.key] || []).map(r => ({
            [t.first]: r.label, 'Đơn báo giá': r.quoted, 'Đơn chốt': r.orders, 'Tỷ lệ chốt (%)': r.winRate,
            'Doanh thu': r.revenue, 'Cost': r.cost, 'Lợi nhuận gộp': r.profit, 'Biên LN (%)': r.margin,
            ...(t.money ? { 'Đã thu': r.collected, 'Còn nợ': Math.max(0, r.debt) } : { 'Hoạt động trong kỳ': r.extra || '' })
        }));
        XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(rows), t.sheet);
    }
    const { titleStr } = getDateRange();
    XLSX.writeFile(wb, `BaoCaoKinhDoanh_${String(titleStr).replace(/[^\w]+/g, '_')}.xlsx`);
}

async function calculateBonus() {
    if (!currentReportData || currentReportData.summary.totalRevenue === 0) return Swal.fire('Cảnh báo', 'Doanh thu bằng 0!', 'warning');
    const { titleStr } = getDateRange();
    currentPeriodStr = titleStr;
    const payload = {
        monthStr: titleStr,
        salePercent: parseFloat(document.getElementById('salePercent').value) || 0,
        headPercent: parseFloat(document.getElementById('headPercent').value) || 0,
        designerPercent: parseFloat(document.getElementById('designerPercent').value) || 0,
        reportData: currentReportData
    };
    Swal.fire({ title: 'Đang tính toán...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
    
    try {
        const res = await fetch('/api/reports/calculate-bonus', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const result = await res.json();
        if (result.success) {
            currentBonusList = result.data;
            document.getElementById('bonusTitle').innerText = `BẢNG KÊ TIỀN THƯỞNG - ${titleStr.toUpperCase()}`;
            
            let total = 0;
            document.getElementById('bonusTbody').innerHTML = currentBonusList.map(b => {
                total += b.TienThuong;
                return `<tr class="border-b hover:bg-gray-50">
                    <td class="p-3 text-xs font-bold text-gray-600">${b.Nhom}</td>
                    <td class="p-3 font-bold text-indigo-700">${b.NhanVien}</td>
                    <td class="p-3 text-xs">${b.NoiDung}</td>
                    <td class="p-3 text-right text-xs text-gray-500">${formatVND(b.DoanhThuTinhThuong)}</td>
                    <td class="p-3 text-right font-black text-emerald-600">${formatVND(b.TienThuong)}</td>
                </tr>`;
            }).join('');
            
            document.getElementById('totalBonusAmount').innerText = formatVND(total);
            Swal.close();
            document.getElementById('modalBonus').classList.remove('hidden');
        }
    } catch (e) { Swal.fire('Lỗi', 'Lỗi tính toán', 'error'); }
}

function exportExcelBonus() {
    if(currentBonusList.length === 0) return;
    // Chuẩn bị dữ liệu để xuất Excel
    const dataToExport = currentBonusList.map(b => ({
        'STT': b.STT,
        'Nhóm': b.Nhom,
        'Nhân Viên': b.NhanVien,
        'Nội dung': b.NoiDung,
        'Doanh thu tính thưởng (VNĐ)': b.DoanhThuTinhThuong,
        'Số tiền chi thưởng (VNĐ)': b.TienThuong
    }));
    const ws = XLSX.utils.json_to_sheet(dataToExport);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Bang_Thuong");
    
    // Tên file theo chu kỳ
    const safePeriodStr = currentPeriodStr.replace(/\//g, '-').replace(/\s/g, '_');
    XLSX.writeFile(wb, `DeNghiChiThuong_${safePeriodStr}.xlsx`);
}


// --- HÀM XUẤT PDF CHUYÊN NGHIỆP ---
