<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>
<main class="flex-1 p-8 overflow-y-auto bg-gray-100 custom-scrollbar">
    <div class="max-w-[1600px] mx-auto">
<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-black text-slate-800 tracking-tight text-indigo-600 uppercase">Dự án Ngoài Công Ty</h1>
        <p class="text-sm text-gray-500 italic">Quản lý dòng tiền: Tổng thu khách và Nghĩa vụ hoàn trả Công ty</p>
    </div>
    <button onclick="openExternalModal()" class="bg-indigo-600 text-white px-6 py-3 rounded-2xl font-bold shadow-lg hover:bg-indigo-700 transition-all active:scale-95 uppercase text-xs">
        <i class="fas fa-plus-circle mr-2"></i>Tạo Dự án Ngoài
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm">
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest">Thu khách thực tế</p>
        <p id="stat-total-khach" class="text-xl font-black text-slate-700">0 đ</p>
    </div>
    <div class="bg-red-600 p-5 rounded-2xl shadow-xl text-white relative overflow-hidden">
        <div class="relative z-10">
            <p class="text-[10px] font-bold opacity-80 uppercase tracking-widest">Đã trả Công ty</p>
            <p id="stat-total-cty" class="text-2xl font-black">0 đ</p>
        </div>
        <i class="fas fa-arrow-right-from-bracket absolute -right-2 -bottom-2 text-6xl opacity-10"></i>
    </div>
    <div class="bg-indigo-50 p-5 rounded-2xl border border-indigo-100 shadow-sm">
        <p class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest">Lợi nhuận dự kiến</p>
        <p id="stat-total-lai" class="text-xl font-black text-indigo-700">0 đ</p>
    </div>
    <div class="bg-green-600 p-5 rounded-2xl shadow-xl text-white relative overflow-hidden">
        <div class="relative z-10">
            <p class="text-[10px] font-bold opacity-80 uppercase tracking-widest">Hoa hồng của bạn</p>
            <p id="stat-my-share" class="text-2xl font-black">0 đ</p>
        </div>
        <i class="fas fa-wallet absolute -right-2 -bottom-2 text-6xl opacity-10"></i>
    </div>
</div>

<div class="bg-white rounded-3xl shadow-sm overflow-x-auto border border-gray-100">
    <table class="w-full text-left min-w-[1300px]">
        <thead class="bg-slate-50 text-[10px] font-black text-slate-400 uppercase border-b">
            <tr>
                <th class="p-5">Ngày Tạo</th>
                <th class="p-5">Dự án / Khách</th>
                <th class="p-5 text-right">Báo Khách</th>
                <th class="p-5 text-right">Giá Gốc x Hệ số</th>
                <th class="p-5 text-right text-red-400">PS (Bạn chi)</th>
                <th class="p-5 text-right text-orange-400">PS (Cty chi)</th>
                <th class="p-5 text-right">Lãi Thuần</th>
                <th class="p-5 text-right text-red-600 bg-red-50 font-black">TRẢ CTY</th>
                <th class="p-5">Ghi chú</th>
                <th class="p-5 text-center">Trạng thái</th>
                <th class="p-5 text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody id="external-project-tbody" class="text-sm divide-y divide-gray-50"></tbody>
    </table>
</div>

<div id="modalExternal" class="fixed inset-0 bg-slate-900/60 hidden flex items-center justify-center p-4 z-50 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white rounded-3xl w-full max-w-6xl overflow-hidden shadow-2xl animate-in fade-in zoom-in duration-200 my-8">
        
        <div class="p-5 bg-indigo-600 text-white font-bold flex justify-between items-center">
            <div class="flex items-center gap-3">
                <i class="fas fa-file-invoice-dollar text-xl"></i>
                <span id="modalExtTitle" class="tracking-tight uppercase text-sm font-black">Quyết toán dòng tiền dự án ngoài</span>
            </div>
            <button onclick="closeExternalModal()" class="text-white opacity-50 hover:opacity-100 transition">
                <i class="fas fa-times-circle text-xl"></i>
            </button>
        </div>
        
        <form class="p-8 lg:p-10 grid grid-cols-12 gap-10" id="formExternal" onsubmit="handleSaveExternal(event)">
            <input type="hidden" id="ext_id">
            
            <div class="col-span-12 lg:col-span-6 space-y-6 border-r border-slate-100 pr-6">
                <h3 class="font-bold text-indigo-600 uppercase text-[11px] tracking-widest flex items-center mb-4 border-b pb-2">
                    <i class="fas fa-info-circle mr-2"></i> 1. Thông tin & Chi phí
                </h3>

                <div class="grid grid-cols-12 gap-4">
                    <div class="col-span-8">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên dự án</label>
                        <input type="text" id="ext_name" class="w-full border-2 border-slate-100 rounded-xl p-3 font-bold focus:border-indigo-500 outline-none transition" required>
                    </div>
                    <div class="col-span-4">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Ngày tạo</label>
                        <input type="date" id="ext_created_at" class="w-full border-2 border-slate-100 rounded-xl p-3 text-xs font-bold outline-none" required>
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Khách hàng từ hệ thống</label>
                    <select id="ext_maKH" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm font-bold bg-white outline-none focus:border-indigo-500"></select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="p-4 bg-slate-50 rounded-2xl border border-slate-200">
                        <label class="block text-[10px] font-black text-slate-400 uppercase mb-2 italic">Giá gốc Cty báo</label>
                        <input type="number" id="ext_price_root" class="w-full bg-transparent text-xl font-black text-slate-700 outline-none" value="0" oninput="calcExt()">
                    </div>
                    <div class="p-4 bg-blue-50 rounded-2xl border border-blue-100">
                        <label class="block text-[10px] font-black text-blue-500 uppercase mb-2 italic">Giá báo khách</label>
                        <input type="number" id="ext_price_guest" class="w-full bg-transparent text-xl font-black text-blue-700 outline-none" value="0" oninput="calcExt()">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="p-4 bg-red-50 rounded-2xl border border-red-100">
                        <label class="block text-[9px] font-black text-red-400 uppercase mb-1">PS (Bạn tự chi)</label>
                        <input type="number" id="ext_ps_me" class="w-full bg-transparent text-lg font-bold text-red-700 outline-none" value="0" oninput="calcExt()">
                    </div>
                    <div class="p-4 bg-orange-50 rounded-2xl border border-orange-100">
                        <label class="block text-[9px] font-black text-orange-400 uppercase mb-1">PS (Cty chi hộ)</label>
                        <input type="number" id="ext_ps_cty" class="w-full bg-transparent text-lg font-bold text-orange-700 outline-none" value="0" oninput="calcExt()">
                    </div>
                </div>

                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Mô tả / Ghi chú phát sinh</label>
                    <textarea id="ext_note" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm outline-none focus:border-indigo-500" rows="3" placeholder="Chi tiết linh kiện mua ngoài..."></textarea>
                </div>
            </div>

            <div class="col-span-12 lg:col-span-6 space-y-6">
                <h3 class="font-bold text-emerald-600 uppercase text-[11px] tracking-widest flex items-center mb-4 border-b pb-2">
                    <i class="fas fa-hand-holding-usd mr-2"></i> 2. Thanh toán & Quyết toán
                </h3>

                <div class="bg-blue-50/30 p-4 rounded-2xl border border-dashed border-blue-200">
                    <p class="text-[9px] font-black text-blue-500 uppercase mb-3">Mốc khách thanh toán cho bạn</p>
                    <div id="ext_list_pay_guest" class="space-y-2 mb-3 max-h-32 overflow-y-auto"></div>
                    <div class="flex gap-2">
                        <input type="date" id="add_pay_guest_date" class="text-[10px] border rounded-lg p-2 w-32 outline-none">
                        <input type="number" id="add_pay_guest_amount" placeholder="Số tiền..." class="text-[10px] border rounded-lg p-2 flex-1 outline-none font-bold">
                        <button type="button" onclick="addExtPayment('guest')" class="bg-blue-600 text-white px-4 rounded-lg text-xs font-black hover:bg-blue-700 transition">+</button>
                    </div>
                </div>

                <div class="bg-red-50/30 p-4 rounded-2xl border border-dashed border-red-200">
                    <p class="text-[9px] font-black text-red-500 uppercase mb-3">Mốc bạn đã quyết toán cho Cty</p>
                    <div id="ext_list_pay_cty" class="space-y-2 mb-3 max-h-32 overflow-y-auto"></div>
                    <div class="flex gap-2">
                        <input type="date" id="add_pay_cty_date" class="text-[10px] border rounded-lg p-2 w-32 outline-none">
                        <input type="number" id="add_pay_cty_amount" placeholder="Số tiền..." class="text-[10px] border rounded-lg p-2 flex-1 outline-none font-bold">
                        <button type="button" onclick="addExtPayment('cty')" class="bg-red-600 text-white px-4 rounded-lg text-xs font-black hover:bg-red-700 transition">+</button>
                    </div>
                </div>

                <div class="bg-slate-900 rounded-[2.5rem] p-8 text-white shadow-2xl space-y-6 relative overflow-hidden border-4 border-slate-800">
                    <div class="flex justify-between items-end border-b border-slate-800 pb-4">
                        <div>
                            <span class="text-[9px] text-slate-500 uppercase font-black block mb-1">Nghĩa vụ trả Cty</span>
                            <span id="res-cty-total" class="text-xl font-black text-white">0 đ</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[9px] text-red-500 uppercase font-black block mb-1">Bạn còn thiếu Cty</span>
                            <span id="res-my-debt-status" class="text-3xl font-black text-red-500 tracking-tighter">0 đ</span>
                        </div>
                    </div>
                    
                    <div class="flex justify-between items-end">
                        <div>
                            <span class="text-[9px] text-slate-500 uppercase font-black block mb-1">Lương thực nhận</span>
                            <span id="res-me-total" class="text-xl font-black text-emerald-400">0 đ</span>
                        </div>
                        <div class="text-right">
                            <span class="text-[9px] text-blue-400 uppercase font-black block mb-1">Khách còn nợ bạn</span>
                            <span id="res-guest-debt-status" class="text-2xl font-black text-blue-400 tracking-tighter">0 đ</span>
                        </div>
                    </div>
                    
                    <div class="flex gap-4 pt-3 border-t border-slate-800">
                        <div class="flex-1">
                            <label class="block text-[8px] font-bold text-slate-500 uppercase mb-1">Hệ số lãi</label>
                            <input type="number" id="ext_he_so" step="0.1" class="bg-transparent border-b border-slate-700 text-sm font-black w-full outline-none text-indigo-400" value="1.2" oninput="calcExt()">
                        </div>
                        <div class="flex-1">
                            <label class="block text-[8px] font-bold text-slate-500 uppercase mb-1">Trạng thái</label>
                            <select id="ext_pay_status" class="bg-transparent border-b border-slate-700 text-[10px] font-black w-full outline-none text-yellow-500 uppercase">
                                <option value="Chưa thu tiền" class="bg-slate-900">Chưa thu tiền</option>
                                <option value="Đã thu tiền khách" class="bg-slate-900">Đã thu tiền khách</option>
                                <option value="Đã quyết toán Cty" class="bg-slate-900">Đã quyết toán Cty</option>
                                <option value="Hoàn tất" class="bg-slate-900">Hoàn tất</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4">
                    <button type="button" onclick="closeExternalModal()" class="px-6 py-3 text-slate-400 font-bold hover:text-red-500 transition uppercase text-xs">Đóng</button>
                    <button type="submit" class="bg-indigo-600 text-white px-10 py-3 rounded-2xl font-black shadow-lg hover:bg-indigo-700 transition active:scale-95 text-xs uppercase tracking-widest">
                        Lưu toàn bộ
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
</main>
<script>
let allExternalProjects = [];
let currentExtPaymentsGuest = [];
let currentExtPaymentsCty = [];

// --- 1. RENDER BẢNG CHÍNH ---
async function renderTable() {
    try {
        const response = await fetch('/api/external-projects');
        allExternalProjects = await response.json();
        
        const tbody = document.getElementById('external-project-tbody');
        if (!tbody) return;
        tbody.innerHTML = '';

        let sKhach = 0, sCty = 0, sMe = 0, sLai = 0;

        allExternalProjects.forEach(p => {
            const ctyTarget = (p.priceRoot || 0) * (p.heSo || 1.2);
            const profit = Math.max(0, (p.priceGuest || 0) - (ctyTarget + (p.psMe || 0) + (p.psCty || 0)));
            const share = profit / 2;
            const ctyTotal = ctyTarget + share + (p.psCty || 0);
            const meTotal = share + (p.psMe || 0);

            sKhach += (p.priceGuest || 0); 
            sCty += ctyTotal; 
            sMe += meTotal; 
            sLai += profit;

            tbody.innerHTML += `
                <tr class="group hover:bg-slate-50 transition-colors border-b">
                    <td class="p-5 text-[10px] font-bold text-slate-400">${p.createdAt}</td>
                    <td class="p-5 font-bold text-slate-700">${p.name}</td>
                    <td class="p-5 text-right font-black text-blue-600">${formatVND(p.priceGuest)}</td>
                    <td class="p-5 text-right text-slate-400 text-xs">${formatVND(ctyTarget)}</td>
                    <td class="p-5 text-right text-red-500 font-bold text-xs">${formatVND(p.psMe)}</td>
                    <td class="p-5 text-right text-orange-500 font-bold text-xs">${formatVND(p.psCty)}</td>
                    <td class="p-5 text-right text-slate-500 font-medium">${formatVND(profit)}</td>
                    <td class="p-5 text-right font-black text-red-600 bg-red-50/50">${formatVND(ctyTotal)}</td>
                    <td class="p-5 text-[11px] text-slate-400 italic max-w-[200px] truncate">${p.note || '-'}</td>
                    <td class="p-5 text-center">
                        <span class="px-2 py-1 rounded-md text-[9px] font-black uppercase ${getStatusClass(p.payStatus)}">${p.payStatus}</span>
                    </td>
                    <td class="p-5 text-center">
                        <div class="flex items-center justify-center gap-2">
                            <button onclick="editExt(${p.id})" class="text-indigo-600 hover:scale-125 transition"><i class="fas fa-edit"></i></button>
                            <button onclick="deleteExt(${p.id})" class="text-red-400 hover:scale-125 transition"><i class="fas fa-trash-alt"></i></button>
                        </div>
                    </td>
                </tr>`;
        });

        document.getElementById('stat-total-khach').innerText = formatVND(sKhach) + ' đ';
        document.getElementById('stat-total-cty').innerText = formatVND(sCty) + ' đ';
        document.getElementById('stat-total-lai').innerText = formatVND(sLai) + ' đ';
        document.getElementById('stat-my-share').innerText = formatVND(sMe) + ' đ';

    } catch (e) { console.error(e); }
}

// --- 2. TÍNH TOÁN DÒNG TIỀN TRONG MODAL ---
function calcExt() {
    const root = parseFloat(document.getElementById('ext_price_root').value) || 0;
    const guest = parseFloat(document.getElementById('ext_price_guest').value) || 0;
    const heso = parseFloat(document.getElementById('ext_he_so').value) || 1.2;
    const psMe = parseFloat(document.getElementById('ext_ps_me').value) || 0;
    const psCty = parseFloat(document.getElementById('ext_ps_cty').value) || 0;

    const ctyTarget = root * heso; 
    const profit = Math.max(0, guest - (ctyTarget + psMe + psCty)); 
    const share = profit / 2;
    const totalObligationToCty = ctyTarget + share + psCty;

    const actualPaidByGuest = currentExtPaymentsGuest.reduce((sum, p) => sum + (parseFloat(p.amount) || 0), 0);
    const actualPaidToCty = currentExtPaymentsCty.reduce((sum, p) => sum + (parseFloat(p.amount) || 0), 0);

    document.getElementById('res-cty-total').innerText = formatVND(totalObligationToCty) + ' đ';
    document.getElementById('res-me-total').innerText = formatVND(share + psMe) + ' đ';
    document.getElementById('res-my-debt-status').innerText = formatVND(totalObligationToCty - actualPaidToCty) + ' đ';
    document.getElementById('res-guest-debt-status').innerText = formatVND(guest - actualPaidByGuest) + ' đ';
}

// --- 3. MỐC THANH TOÁN ---
function addExtPayment(type) {
    const date = document.getElementById(`add_pay_${type}_date`).value;
    const amount = parseInt(document.getElementById(`add_pay_${type}_amount`).value);
    if(!date || !amount) return alert("Vui lòng nhập đủ thông tin!");

    if(type === 'guest') currentExtPaymentsGuest.push({date, amount});
    else currentExtPaymentsCty.push({date, amount});

    renderExtPayments();
    calcExt();
    document.getElementById(`add_pay_${type}_amount`).value = '';
}

function removeExtPay(targetId, idx) {
    if(targetId === 'ext_list_pay_guest') currentExtPaymentsGuest.splice(idx, 1);
    else currentExtPaymentsCty.splice(idx, 1);
    renderExtPayments();
    calcExt();
}

function renderExtPayments() {
    const draw = (list, targetId) => {
        const el = document.getElementById(targetId);
        if(!el) return;
        el.innerHTML = list.map((p, idx) => `
            <div class="flex justify-between items-center bg-white p-2 rounded-xl text-[10px] shadow-sm border border-slate-100">
                <span class="font-bold text-slate-500">${p.date}</span>
                <span class="text-blue-600 font-black">${formatVND(p.amount)} đ</span>
                <button type="button" onclick="removeExtPay('${targetId}', ${idx})" class="text-red-400 hover:text-red-600 transition"><i class="fas fa-times-circle"></i></button>
            </div>
        `).join('');
    };
    draw(currentExtPaymentsGuest, 'ext_list_pay_guest');
    draw(currentExtPaymentsCty, 'ext_list_pay_cty');
}

// --- 4. HÀM MỞ MODAL (SỬA) ---
async function editExt(id) {
    const p = allExternalProjects.find(x => x.id == id);
    if (!p) return;

    await loadExtKH();

    document.getElementById('modalExtTitle').innerText = "Chỉnh sửa quyết toán: " + p.name;
    document.getElementById('ext_id').value = p.id;
    document.getElementById('ext_name').value = p.name;
    document.getElementById('ext_maKH').value = p.maKH || '';
    document.getElementById('ext_created_at').value = p.createdAt;
    document.getElementById('ext_price_root').value = p.priceRoot || 0;
    document.getElementById('ext_price_guest').value = p.priceGuest || 0;
    document.getElementById('ext_ps_me').value = p.psMe || 0;
    document.getElementById('ext_ps_cty').value = p.psCty || 0;
    document.getElementById('ext_note').value = p.note || '';
    document.getElementById('ext_pay_status').value = p.payStatus || 'Chưa thu tiền';
    document.getElementById('ext_he_so').value = p.heSo || 1.2;

    // Load mốc thanh toán
    currentExtPaymentsGuest = p.payments_guest ? (typeof p.payments_guest === 'string' ? JSON.parse(p.payments_guest) : p.payments_guest) : [];
    currentExtPaymentsCty = p.payments_company ? (typeof p.payments_company === 'string' ? JSON.parse(p.payments_company) : p.payments_company) : [];
    
    renderExtPayments();
    document.getElementById('modalExternal').classList.remove('hidden');
    calcExt();
}

// --- 5. HÀM MỞ MODAL (MỚI) ---
async function openExternalModal() {
    await loadExtKH(); 
    document.getElementById('formExternal').reset();
    document.getElementById('modalExtTitle').innerText = "Tạo quyết toán dự án ngoài";
    document.getElementById('ext_id').value = '';
    currentExtPaymentsGuest = [];
    currentExtPaymentsCty = [];
    renderExtPayments();
    document.getElementById('ext_created_at').valueAsDate = new Date();
    document.getElementById('ext_he_so').value = 1.2;
    document.getElementById('modalExternal').classList.remove('hidden');
    calcExt();
}

// --- CÁC HÀM CÒN LẠI ---
async function handleSaveExternal(e) {
    e.preventDefault();
    const data = {
        id: document.getElementById('ext_id').value || null,
        name: document.getElementById('ext_name').value,
        maKH: document.getElementById('ext_maKH').value,
        createdAt: document.getElementById('ext_created_at').value,
        priceRoot: parseFloat(document.getElementById('ext_price_root').value),
        priceGuest: parseFloat(document.getElementById('ext_price_guest').value),
        psMe: parseFloat(document.getElementById('ext_ps_me').value),
        psCty: parseFloat(document.getElementById('ext_ps_cty').value),
        note: document.getElementById('ext_note').value,
        payStatus: document.getElementById('ext_pay_status').value,
        heSo: parseFloat(document.getElementById('ext_he_so').value),
        payments_guest: currentExtPaymentsGuest,
        payments_company: currentExtPaymentsCty
    };

    const res = await fetch('/api/external-projects/save', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify(data)
    });
    
    if((await res.json()).success) {
        closeExternalModal();
        renderTable();
    }
}

async function loadExtKH() {
    try {
        const res = await fetch('/api/customers');
        const customers = await res.json();
        const selectKH = document.getElementById('ext_maKH');
        if (selectKH) {
            let options = '<option value="">-- Chọn Khách Hàng --</option>';
            options += customers.map(kh => `<option value="${kh.maKH}">${kh.tenKH} (${kh.maKH})</option>`).join('');
            selectKH.innerHTML = options;
        }
    } catch (e) { console.error(e); }
}

async function deleteExt(id) {
    if(!confirm("Xác nhận xóa vĩnh viễn?")) return;
    await fetch(`/api/external-projects/${id}`, { method: 'DELETE' });
    renderTable();
}

function formatVND(num) { return new Intl.NumberFormat('vi-VN').format(Math.round(num || 0)); }

function getStatusClass(status) {
    if(status === 'Hoàn tất') return 'bg-green-100 text-green-700';
    if(status === 'Đã thu tiền khách') return 'bg-blue-100 text-blue-700';
    if(status === 'Đã quyết toán Cty') return 'bg-purple-100 text-purple-700';
    return 'bg-gray-100 text-gray-500';
}

function closeExternalModal() { document.getElementById('modalExternal').classList.add('hidden'); }

window.onload = renderTable;
</script>

<%- include('../partials/footer') %>