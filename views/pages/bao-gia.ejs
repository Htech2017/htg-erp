        <table class="w-full text-xs border">${head}<tbody>${b.rows.map(l => `<tr class="border-b ${l.khachCap ? 'bg-sky-50' : (l.toBuy > 0 ? '' : 'text-gray-400')}">
            <td class="p-2 text-left">${esc(l.name)}</td><td class="p-2 text-right">${fmtVND(l.need)}</td><td class="p-2 text-right text-emerald-600">${l.fromStock ? fmtVND(l.fromStock) : '—'}</td>
