        html: `<p class="text-xs text-gray-500">Mỗi loại mạch một bảng riêng, không gộp giữa các mạch.</p>${html}<p class="text-right text-sm mt-3">Tổng tiền mua cả đơn: <b class="text-red-600">${fmtVND(data.total)} đ</b></p>` });
}

// ================= CONG CU BAO GIA GIA CONG =================
let asm = { orderId: null, lineId: null, qty: 0, bomTable: null, source: [] };
const ASM_RATES = ['smdPad', 'thtPad', 'ic', 'test', 'setup', 'lossPercent'];
const ASM_COUNTS = ['smdPads', 'thtPads', 'icCount'];
const asmVal = id => num(document.getElementById(id).value);

async function openAssemblyTool(orderId, lineId) {
    const { o, line, it } = findQuoteItem(orderId, lineId, 'giaCostGiaCong');
    if (!it) return;
    asm = { orderId, lineId, qty: it.quantity || 0, bomTable: null, source: [] };
    document.getElementById('asmTitle').textContent = `${o.maDH} · ${line.tenMach || ''}`;
    document.getElementById('asmQty').textContent = fmtVND(asm.qty);
    ['asmBomResult', 'asmGerberResult', 'asmBomMap'].forEach(id => document.getElementById(id).classList.add('hidden'));
    document.getElementById('asmBomUpload').value = '';
    document.getElementById('asmGerberUpload').value = '';

    // Don gia: lay tu lan bao gia truoc cua mach nay, neu chua co thi lay don gia mac dinh cua xuong
    const saved = it.detail && it.detail.assembly;
    let rates = saved ? saved.rates : null;
    if (!rates) {
        const r = await (await fetch('/api/orders/production-rates')).json();
        rates = r.success ? r.rates : {};
    }
    ASM_RATES.forEach(k => { document.getElementById('asm_r_' + k).value = rates[k] || ''; });
    document.getElementById('asmRateHint').classList.toggle('hidden', ASM_RATES.some(k => rates[k] > 0));
    ASM_COUNTS.forEach(k => { document.getElementById('asm_' + k).value = saved ? saved.counts[k] : ''; });
    asmRecalc();
    document.getElementById('asmModal').style.display = 'flex';

    // File trong thu muc Drive cua don hang
    const fill = async (selId, kind) => {
        const sel = document.getElementById(selId);
        sel.innerHTML = '<option value="">Đang tìm file...</option>';
        try {
            const d = await (await fetch(`/api/inventory/bom/drive-files?orderId=${orderId}${kind ? '&kind=' + kind : ''}`)).json();
            sel.innerHTML = (d.files || []).length ? d.files.map(f => `<option value="${esc(f.id)}">${esc(f.name)}</option>`).join('') : '<option value="">Không có file phù hợp trên Drive</option>';
        } catch (e) { sel.innerHTML = '<option value="">Không đọc được Drive</option>'; }
    };
    fill('asmBomFile', ''); fill('asmGerberFile', 'gerber');
}
function closeAssemblyTool() { document.getElementById('asmModal').style.display = 'none'; }

function asmRecalc() {
    const perBoard = asmVal('asm_smdPads') * asmVal('asm_r_smdPad') + asmVal('asm_thtPads') * asmVal('asm_r_thtPad') + asmVal('asm_icCount') * asmVal('asm_r_ic') + asmVal('asm_r_test');
    const total = Math.round(perBoard * asm.qty * (1 + asmVal('asm_r_lossPercent') / 100) + asmVal('asm_r_setup'));
    document.getElementById('asmPerBoard').textContent = fmtVND(Math.round(perBoard)) + ' đ';
    document.getElementById('asmTotal').textContent = fmtVND(total) + ' đ';
}
function asmUse(counts, source) {
    Object.keys(counts).forEach(k => { if (counts[k] !== null && counts[k] !== undefined) document.getElementById('asm_' + k).value = counts[k]; });
    if (!asm.source.includes(source)) asm.source.push(source);
    asmRecalc();
}
const asmRatesObj = () => { const r = {}; ASM_RATES.forEach(k => { r[k] = asmVal('asm_r_' + k); }); return r; };

async function asmSaveRates() {
    const r = await (await fetch('/api/orders/production-rates', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(asmRatesObj()) })).json();
    if (r.success) { document.getElementById('asmRateHint').classList.add('hidden'); Swal.fire({ toast: true, position: 'top-end', icon: 'success', timer: 2000, showConfirmButton: false, title: 'Đã lưu đơn giá mặc định' }); }
    else Swal.fire({ icon: 'error', title: 'Lỗi', text: r.error || '' });
}

// --- Nguon 1: BOM ---
async function asmLoadBom(from) {
    let res;
    if (from === 'drive') {
        const fileId = document.getElementById('asmBomFile').value;
        if (!fileId) return Swal.fire({ icon: 'info', title: 'Chưa có file', text: 'Chọn file trong danh sách hoặc tải file BOM từ máy.' });
        res = await fetch('/api/inventory/bom/parse', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderId: asm.orderId, fileId }) });
    } else {
        const file = document.getElementById('asmBomUpload').files[0];
        if (!file) return;
        const fd = new FormData(); fd.append('file', file);
        res = await fetch('/api/inventory/bom/parse', { method: 'POST', body: fd });
    }
    const data = await res.json();
    if (!data.success) return Swal.fire({ icon: 'error', title: 'Không đọc được BOM', text: data.error || '' });
    asm.bomTable = data;
    const options = '<option value="">—</option>' + data.headers.map((h, i) => `<option value="${i}">${esc(h)}</option>`).join('');
    ['name', 'package', 'ref', 'qty'].forEach(f => {
        const sel = document.getElementById('asm_map_' + f);
        sel.innerHTML = options;
        sel.value = data.mapping[f] !== undefined ? String(data.mapping[f]) : '';
    });
    document.getElementById('asmBomMap').classList.remove('hidden');
    if (data.mapping.package !== undefined) asmEstimate();
}
async function asmEstimate() {
    const col = f => { const v = document.getElementById('asm_map_' + f).value; return v === '' ? null : Number(v); };
    const map = { name: col('name'), package: col('package'), ref: col('ref'), qty: col('qty') };
    if (map.package === null) return Swal.fire({ icon: 'warning', title: 'Thiếu cột', text: 'Chọn cột Kiểu chân (footprint) của BOM.' });
    const cell = (r, f) => map[f] === null ? '' : String(r[map[f]] === undefined ? '' : r[map[f]]).trim();
    const rows = asm.bomTable.rows.map(r => ({ name: cell(r, 'name'), package: cell(r, 'package'), ref: cell(r, 'ref'), qty: cell(r, 'qty') })).filter(r => r.name || r.package || r.ref);
    const data = await (await fetch('/api/inventory/bom/assembly-estimate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rows }) })).json();
    if (!data.success) return Swal.fire({ icon: 'error', title: 'Lỗi', text: data.error || '' });
    asm.bomEstimate = data.totals;
    const t = data.totals;
    const unknown = data.lines.filter(l => l.pins === null || !l.mount);
    const box = document.getElementById('asmBomResult');
    box.innerHTML = `
        <p><b>${fmtVND(t.smdPads)}</b> điểm dán (${fmtVND(t.smdParts)} linh kiện) · <b>${fmtVND(t.thtPads)}</b> điểm cắm (${fmtVND(t.thtParts)} linh kiện) · <b>${fmtVND(t.icCount)}</b> IC</p>
        ${unknown.length ? `<p class="text-amber-600 mt-1">${unknown.length} dòng chưa nhận ra kiểu chân, CHƯA được tính — hãy cộng thêm tay:</p>
        <div class="max-h-28 overflow-y-auto border rounded mt-1"><table class="w-full">${unknown.map(l => `<tr class="border-b"><td class="px-2 py-1">${esc(l.name || '')}</td><td class="px-2 py-1 text-gray-500">${esc(l.package || '(trống)')}</td><td class="px-2 py-1 text-right">SL ${fmtVND(l.qty)}</td></tr>`).join('')}</table></div>` : '<p class="text-emerald-600 mt-1">Đã nhận ra kiểu chân của tất cả các dòng.</p>'}
        <button onclick="asmUse({ smdPads: ${t.smdPads}, thtPads: ${t.thtPads}, icCount: ${t.icCount} }, 'BOM')" class="mt-2 bg-indigo-600 text-white px-3 py-1.5 rounded-lg font-bold">Dùng số liệu BOM</button>`;
    box.classList.remove('hidden');
}

// --- Nguon 2: gerber / file khoan ---
async function asmLoadGerber(from) {
    let res;
    if (from === 'drive') {
        const fileId = document.getElementById('asmGerberFile').value;
        if (!fileId) return Swal.fire({ icon: 'info', title: 'Chưa có file', text: 'Chọn file trong danh sách hoặc tải file gerber từ máy.' });
        res = await fetch('/api/inventory/bom/gerber-count', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderId: asm.orderId, fileId }) });
    } else {
        const files = document.getElementById('asmGerberUpload').files;
        if (!files.length) return;
        const fd = new FormData();
        for (const f of files) fd.append('files', f);
        res = await fetch('/api/inventory/bom/gerber-count', { method: 'POST', body: fd });
    }
    const data = await res.json();
    if (!data.success) return Swal.fire({ icon: 'error', title: 'Không đọc được gerber', text: data.error || '' });
    asm.gerber = data;
    renderGerberResult();
}
function renderGerberResult() {
    const g = asm.gerber;
    const thrEl = document.getElementById('asmHoleMin');
    const thr = thrEl ? num(thrEl.value) : 0.6;
    const tht = g.holes.filter(h => h.diameter >= thr).reduce((s, h) => s + h.count, 0);
    const via = g.holes.filter(h => h.diameter < thr).reduce((s, h) => s + h.count, 0);
    const smd = g.smdTop + g.smdBottom;
    const box = document.getElementById('asmGerberResult');
    box.innerHTML = `
        ${g.pasteFiles.length ? `<p>Pad dán: <b>${fmtVND(smd)}</b> (mặt trên ${fmtVND(g.smdTop)}, mặt dưới ${fmtVND(g.smdBottom)})</p>` : '<p class="text-amber-600">Không có lớp kem hàn (paste) → chưa đếm được pad dán.</p>'}
        ${g.drillFiles.length ? `<p class="mt-1">Lỗ khoan có mạ: ${g.holes.map(h => `${h.diameter}mm × ${fmtVND(h.count)}`).join(' · ')}</p>
        <p class="mt-1">Coi lỗ từ <input id="asmHoleMin" value="${thr}" onchange="renderGerberResult()" class="border rounded px-1 py-0.5 w-12 text-right"> mm trở lên là chân cắm → <b>${fmtVND(tht)}</b> điểm cắm (bỏ ${fmtVND(via)} lỗ via)</p>` : '<p class="text-amber-600 mt-1">Không có file khoan → chưa đếm được điểm cắm.</p>'}
        <p class="text-gray-400 mt-1">Đã đọc: ${esc([...g.pasteFiles, ...g.drillFiles].map(f => f.name).join(', '))}</p>
        ${asm.bomEstimate ? `<p class="mt-1 text-slate-600">So với BOM: dán ${fmtVND(asm.bomEstimate.smdPads)}, cắm ${fmtVND(asm.bomEstimate.thtPads)}</p>` : ''}
        <button onclick="asmUse({ smdPads: ${g.pasteFiles.length ? smd : null}, thtPads: ${g.drillFiles.length ? tht : null} }, 'Gerber')" class="mt-2 bg-emerald-600 text-white px-3 py-1.5 rounded-lg font-bold">Dùng số liệu gerber</button>`;
    box.classList.remove('hidden');
}

async function saveAssemblyQuote() {
    const counts = {}; ASM_COUNTS.forEach(k => { counts[k] = asmVal('asm_' + k); });
    const res = await fetch(`/api/orders/${asm.orderId}/cost`, {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lineId: asm.lineId, assembly: { counts, rates: asmRatesObj(), source: asm.source.join(' + ') || 'Nhập tay' } })
    });
    const result = await res.json();
    if (!result.success) return Swal.fire({ icon: 'error', title: 'Chưa lưu được', text: result.error || '' });
    closeAssemblyTool();
    Swal.fire({ toast: true, position: 'top-end', icon: 'success', timer: 3000, showConfirmButton: false, title: `Giá gia công: ${fmtVND(result.giaCostGiaCong)} đ` });
    loadQuotes();
}

window.addEventListener('DOMContentLoaded', loadQuotes);
</script>
