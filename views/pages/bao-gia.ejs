            <td class="p-2 text-right">${l.toBuy ? fmtVND(l.buyPrice) : '—'}</td><td class="p-2 text-right font-bold">${l.amount ? fmtVND(l.amount) : '—'}</td></tr>`).join('')}</tbody></table>`).join('')
        : '<p class="p-4 text-gray-400 italic text-sm">Chưa loại mạch nào lập bảng vật tư.</p>';
