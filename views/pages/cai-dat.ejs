<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-8 overflow-y-auto bg-gray-100 custom-scrollbar">
    <div class="max-w-[1600px] mx-auto">
<div class="mb-8">
    <h1 class="text-2xl font-black text-slate-800 tracking-tight">Cài đặt hệ thống</h1>
    <p class="text-sm text-gray-500 italic">Cấu hình kết nối Google Drive và thông tin pháp lý Thương hiệu</p>
</div>

<div class="grid grid-cols-12 gap-8">
    <div class="col-span-12 lg:col-span-5 space-y-6">
        <div id="drive-config-box" class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden transition-all duration-300">
            <div class="p-6 border-b bg-blue-50 flex items-center justify-between">
                <h2 class="font-bold text-blue-900 flex items-center text-sm uppercase">
                    <i class="fab fa-google-drive mr-2 text-xl"></i> Google Drive API
                </h2>
                <span id="drive-lock-status" class="px-2 py-1 bg-blue-100 text-blue-700 text-[10px] font-bold rounded-lg uppercase tracking-tighter">Đang kiểm tra...</span>
            </div>
            <div class="p-6 space-y-5">
                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase mb-2 leading-none">ID Thư mục gốc (Root Folder ID)</label>
                    <div class="flex gap-2">
                        <input type="text" id="drive_root_id" class="flex-1 border rounded-xl p-3 text-sm font-mono bg-gray-50 outline-none focus:ring-2 focus:ring-blue-500" value="1z9X_rYm7aBvC3dE4fG5hI6jK7lM8nO9p">
                        <button onclick="testDriveConnection(event)" class="bg-blue-600 text-white px-4 rounded-xl hover:bg-blue-700 transition" title="Kiểm tra kết nối"><i class="fas fa-link"></i></button>
                    </div>
                </div>

                <div>
                    <label class="block text-[11px] font-black text-slate-400 uppercase mb-2 leading-none">Google Chat Webhook (Nội bộ)</label>
                    <div class="flex gap-2">
                        <input type="password" id="ext_webhook_url" class="flex-1 border rounded-xl p-3 text-sm font-mono bg-gray-50 outline-none" placeholder="https://chat.googleapis.com/v1/spaces/...">
                        <button onclick="testWebhook()" class="bg-amber-500 text-white px-4 rounded-xl hover:bg-amber-600 transition" title="Gửi thử tin nhắn"><i class="fas fa-paper-plane"></i></button>
                    </div>
                </div>

                <div class="pt-4 border-t border-dashed">
                    <button id="btn-save-api" onclick="saveFullConfig()" class="w-full bg-slate-900 text-white py-3 rounded-2xl font-bold shadow-lg hover:bg-black transition uppercase text-xs tracking-widest">Lưu cấu hình hệ thống</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-span-12 lg:col-span-7 space-y-6">
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-6 border-b bg-slate-50 flex items-center justify-between">
                <h2 class="font-bold text-slate-700 flex items-center text-sm uppercase">
                    <i class="fas fa-briefcase text-orange-500 mr-2 text-xl"></i> Danh mục Thương hiệu & Báo giá
                </h2>
                <button onclick="openBrandModal()" class="bg-slate-900 text-white px-4 py-2 rounded-xl text-[10px] font-bold uppercase hover:bg-blue-600 transition">
                    + Thêm Brand
                </button>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 gap-4" id="brand-list"></div>
            </div>
        </div>
    </div>
</div>

<div id="modalBrand" class="fixed inset-0 bg-slate-900/60 hidden flex items-center justify-center p-4 z-50 backdrop-blur-sm overflow-y-auto">
    <div class="bg-white rounded-3xl w-full max-w-2xl overflow-hidden shadow-2xl my-8">
        <div class="p-5 bg-slate-900 text-white font-bold flex justify-between items-center">
            <span class="text-sm uppercase tracking-wider">Cấu hình chi tiết Thương hiệu</span>
            <button onclick="closeBrandModal()"><i class="fas fa-times-circle text-xl opacity-50 hover:opacity-100 transition"></i></button>
        </div>
        <form class="p-8 grid grid-cols-12 gap-5" onsubmit="handleSaveBrand(event)">
            <input type="hidden" id="brand_id">
            <div class="col-span-8">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Tên Công ty (Hiển thị báo giá)</label>
                <input type="text" id="b_company_name" class="w-full border rounded-xl p-2.5 font-bold" required>
            </div>
            <div class="col-span-4">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Mã Brand</label>
                <input type="text" id="b_code" maxlength="5" class="w-full border rounded-xl p-2.5 font-bold uppercase" required>
            </div>
            <div class="col-span-12">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Địa chỉ văn phòng</label>
                <input type="text" id="b_address" class="w-full border rounded-xl p-2.5 text-sm">
            </div>
            <div class="col-span-12 bg-gray-50 p-4 rounded-2xl border border-dashed">
                <label class="block text-[10px] font-black text-blue-600 uppercase mb-3"><i class="fas fa-university mr-1"></i> Thông tin thanh toán</label>
                <div class="grid grid-cols-2 gap-4">
                    <input type="text" id="b_bank_name" class="w-full border rounded-lg p-2 text-sm" placeholder="Ngân hàng">
                    <input type="text" id="b_bank_no" class="w-full border rounded-lg p-2 text-sm font-bold" placeholder="Số tài khoản">
                    <input type="text" id="b_bank_owner" class="col-span-2 w-full border rounded-lg p-2 text-sm uppercase font-bold" placeholder="Chủ tài khoản">
                </div>
            </div>
            <div class="col-span-12 grid grid-cols-2 gap-5">
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Link Logo Công ty</label>
                    <input type="text" id="b_logo_url" class="w-full border rounded-xl p-2.5 text-xs" placeholder="https://...">
                </div>
                <div>
                    <label class="block text-[10px] font-black text-slate-400 uppercase mb-1">Link QR Thanh toán</label>
                    <input type="text" id="b_qr_url" class="w-full border rounded-xl p-2.5 text-xs" placeholder="https://...">
                </div>
            </div>
            <div class="col-span-12 flex justify-end gap-3 pt-4 border-t">
                <button type="button" onclick="closeBrandModal()" class="px-6 py-2 text-gray-400 font-bold uppercase text-xs">Hủy</button>
                <button type="submit" class="bg-blue-600 text-white px-10 py-3 rounded-2xl font-black shadow-lg uppercase text-xs">Lưu thương hiệu</button>
            </div>
        </form>
    </div>
</div>
</main>
<script>
let currentBrands = [];

// --- 1. RENDER BRANDS ---
async function renderBrands() {
    try {
        const response = await fetch('/api/brands');
        currentBrands = await response.json();
        const list = document.getElementById('brand-list');
        if (!list) return;

        if (currentBrands.length === 0) {
            list.innerHTML = `<div class="p-10 text-center text-gray-400 border-2 border-dashed rounded-3xl font-bold uppercase text-[10px] tracking-widest">Chưa có thương hiệu nào</div>`;
            return;
        }

        list.innerHTML = currentBrands.map(b => `
            <div class="bg-white p-5 rounded-2xl border relative group hover:shadow-md transition-all duration-300">
                <div class="flex items-center gap-4">
                    <div class="flex flex-col gap-1 items-center bg-slate-50 p-2 rounded-xl border border-slate-100">
                        <img src="${b.logo || 'https://via.placeholder.com/80x40'}" class="h-8 w-16 object-contain" title="Logo">
                        <img src="${b.qr_url || 'https://via.placeholder.com/40x40'}" class="h-10 w-10 object-contain bg-white rounded shadow-sm" title="QR">
                    </div>
                    <div>
                        <h4 class="font-black text-slate-800 uppercase text-xs leading-none">${b.company}</h4>
                        <p class="text-[9px] text-gray-400 font-bold mt-1 tracking-wider uppercase">${b.code} | ${b.bankName} | ${b.bankNo}</p>
                    </div>
                </div>
                <div class="absolute top-4 right-4 flex gap-1 opacity-0 group-hover:opacity-100 transition-all">
                    <button onclick="editBrand(${b.id})" class="text-blue-500 p-2 hover:bg-blue-50 rounded-lg"><i class="fas fa-edit text-xs"></i></button>
                    <button onclick="deleteBrand(${b.id})" class="text-red-400 p-2 hover:bg-red-50 rounded-lg"><i class="fas fa-trash text-xs"></i></button>
                </div>
            </div>
        `).join('');
    } catch (e) { console.error(e); }
}

// --- 2. XỬ LÝ DRIVE & WEBHOOK ---
async function testDriveConnection(event) {
    const input = document.getElementById('drive_root_id');
    const folderId = input ? input.value.trim() : null;

    if (!folderId || folderId === "1z9X_rYm7aBvC3dE4fG5hI6jK7lM8nO9p") { 
        // 1z9X... là mã mẫu, nếu user chưa đổi thì cũng báo lỗi
        return alert("Vui lòng nhập ID thư mục Shared Drive thật của bạn!");
    }

    console.log("Đang test với Folder ID:", folderId); // Kiểm tra xem ID có bị rỗng không

    const btn = event.currentTarget;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

    try {
        const res = await fetch('/api/settings/test-drive', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ folderId })
        });
        const result = await res.json();
        // ... xử lý kết quả ...
    } catch (e) {
        alert("Lỗi kết nối Server!");
    } finally {
        btn.innerHTML = '<i class="fas fa-link"></i>';
    }
}

async function saveFullConfig() {
    const folderId = document.getElementById('drive_root_id').value;
    const webhookUrl = document.getElementById('ext_webhook_url').value;

    try {
        await fetch('/api/settings/save-drive', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ folderId })
        });
        await fetch('/api/settings/save-webhook', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ url: webhookUrl })
        });
        alert("🚀 Hệ thống đã cập nhật toàn bộ cấu hình!");
        location.reload();
    } catch (e) { alert("Lỗi khi lưu!"); }
}

async function testWebhook() {
    const url = document.getElementById('ext_webhook_url').value;
    if(!url) return alert("Vui lòng nhập URL Webhook!");
    try {
        await fetch(url, { method: 'POST', body: JSON.stringify({ text: "🔔 Test Webhook OK!" })});
        alert("Đã gửi tin nhắn test!");
    } catch (e) { alert("Thất bại!"); }
}

// --- 3. XỬ LÝ BRAND ---
async function handleSaveBrand(e) {
    e.preventDefault();
    const data = {
        id: document.getElementById('brand_id').value || null,
        company: document.getElementById('b_company_name').value,
        code: document.getElementById('b_code').value.toUpperCase(),
        address: document.getElementById('b_address').value,
        bankName: document.getElementById('b_bank_name').value,
        bankNo: document.getElementById('b_bank_no').value,
        bankOwner: document.getElementById('b_bank_owner').value,
        logo: document.getElementById('b_logo_url').value,
        qr_url: document.getElementById('b_qr_url').value
    };
    await fetch('/api/brands/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
    closeBrandModal();
    renderBrands();
}

function editBrand(id) {
    const b = currentBrands.find(x => x.id === id);
    if (!b) return;
    document.getElementById('brand_id').value = b.id;
    document.getElementById('b_company_name').value = b.company;
    document.getElementById('b_code').value = b.code;
    document.getElementById('b_address').value = b.address;
    document.getElementById('b_bank_name').value = b.bankName;
    document.getElementById('b_bank_no').value = b.bankNo;
    document.getElementById('b_bank_owner').value = b.bankOwner;
    document.getElementById('b_logo_url').value = b.logo || '';
    document.getElementById('b_qr_url').value = b.qr_url || '';
    document.getElementById('modalBrand').classList.remove('hidden');
}

async function deleteBrand(id) {
    if(!confirm("Xóa?")) return;
    await fetch(`/api/brands/${id}`, { method: 'DELETE' });
    renderBrands();
}

function openBrandModal() {
    document.getElementById('brand_id').value = '';
    document.getElementById('modalBrand').querySelector('form').reset();
    document.getElementById('modalBrand').classList.remove('hidden');
}
function closeBrandModal() { document.getElementById('modalBrand').classList.add('hidden'); }

document.addEventListener('DOMContentLoaded', renderBrands);
</script>
<%- include('../partials/footer') %>