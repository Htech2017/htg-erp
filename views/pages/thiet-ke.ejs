<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<main class="flex-1 p-6 overflow-y-auto bg-gray-100 custom-scrollbar">
<div class="max-w-[1600px] mx-auto space-y-5">

<!-- HEADER -->
<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-black text-gray-800 tracking-tight">Điều hành Thiết kế & R&D</h1>
        <p class="text-xs text-gray-400 mt-0.5">Đồng bộ từ đơn hàng <b class="text-emerald-600 uppercase">Đã chốt</b> — loại dịch vụ Thiết kế</p>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
    <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm">
        <p class="text-[9px] font-black text-gray-400 uppercase tracking-widest">Tổng dự án</p>
        <p id="kpi-total" class="text-3xl font-black text-gray-800 mt-1">0</p>
    </div>
    <div class="bg-blue-50 rounded-2xl p-4 border border-blue-100 shadow-sm">
        <p class="text-[9px] font-black text-blue-400 uppercase tracking-widest">Đang xử lý</p>
        <p id="kpi-processing" class="text-3xl font-black text-blue-600 mt-1">0</p>
    </div>
    <div class="bg-amber-50 rounded-2xl p-4 border border-amber-100 shadow-sm">
        <p class="text-[9px] font-black text-amber-500 uppercase tracking-widest">Chưa giao việc</p>
        <p id="kpi-unassigned" class="text-3xl font-black text-amber-500 mt-1">0</p>
    </div>
    <div class="bg-red-50 rounded-2xl p-4 border border-red-100 shadow-sm">
        <p class="text-[9px] font-black text-red-400 uppercase tracking-widest">Trễ hạn</p>
        <p id="kpi-overdue" class="text-3xl font-black text-red-500 mt-1">0</p>
    </div>
    <div class="bg-emerald-50 rounded-2xl p-4 border border-emerald-100 shadow-sm">
        <p class="text-[9px] font-black text-emerald-500 uppercase tracking-widest">Hoàn thành</p>
        <p id="kpi-done" class="text-3xl font-black text-emerald-600 mt-1">0</p>
    </div>
</div>

<!-- FILTERS -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-3">
    <div class="bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
        <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Tìm kiếm</label>
        <input type="text" id="searchDesign" oninput="renderDesignTable()" placeholder="Mã đơn hàng..."
            class="w-full border border-gray-200 rounded-xl p-2 text-sm outline-none focus:ring-2 focus:ring-blue-500 transition-all">
    </div>
    <div class="bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
        <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Trạng thái</label>
        <select id="filterDesignStatus" onchange="renderDesignTable()"
                class="w-full border border-gray-200 rounded-xl p-2 text-sm outline-none bg-gray-50 font-semibold cursor-pointer">
            <option value="Tất cả">Tất cả tiến độ</option>
            <option value="Chưa giao việc">Chưa giao việc</option>
            <option value="Đang xử lý">Đang xử lý</option>
            <option value="Chuyển QL review">Chuyển QL review</option>
            <option value="Đã hoàn thành">Đã hoàn thành</option>
        </select>
    </div>
    <div class="bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
        <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Nhân viên</label>
        <select id="filterDesignStaff" onchange="renderDesignTable()"
                class="w-full border border-gray-200 rounded-xl p-2 text-sm outline-none bg-gray-50 font-semibold cursor-pointer">
            <option value="Tất cả">Tất cả nhân viên</option>
        </select>
    </div>
    <div class="bg-white p-3 rounded-2xl border border-gray-100 shadow-sm">
        <label class="block text-[9px] font-black text-gray-400 uppercase mb-1">Deadline</label>
        <select id="filterDeadline" onchange="renderDesignTable()"
                class="w-full border border-gray-200 rounded-xl p-2 text-sm outline-none bg-gray-50 font-semibold cursor-pointer">
            <option value="Tất cả">Tất cả</option>
            <option value="Trễ hạn">Trễ hạn</option>
            <option value="Sắp đến hạn">Sắp đến hạn (3 ngày)</option>
            <option value="Trong hạn">Trong hạn</option>
        </select>
    </div>
</div>

<!-- TABLE -->
<div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 border-b border-gray-100 text-[10px] font-black text-gray-400 uppercase tracking-widest">
                    <th class="p-4 cursor-pointer hover:text-gray-600" onclick="sortTable('ttThietKe')">Trạng thái <i class="fas fa-sort ml-1 opacity-40"></i></th>
                    <th class="p-4 cursor-pointer hover:text-gray-600" onclick="sortTable('maDH')">Mã Đơn Hàng <i class="fas fa-sort ml-1 opacity-40"></i></th>
                    <th class="p-4 cursor-pointer hover:text-gray-600" onclick="sortTable('designer')">Người phụ trách <i class="fas fa-sort ml-1 opacity-40"></i></th>
                    <th class="p-4">Hạng mục</th>
                    <th class="p-4 cursor-pointer hover:text-gray-600" onclick="sortTable('version')">Phiên bản <i class="fas fa-sort ml-1 opacity-40"></i></th>
                    <th class="p-4 cursor-pointer hover:text-gray-600" onclick="sortTable('deadline')">Deadline <i class="fas fa-sort ml-1 opacity-40"></i></th>
                    <th class="p-4 text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody id="design-tbody" class="divide-y divide-gray-50"></tbody>
        </table>
    </div>
    <div class="flex items-center justify-between px-4 py-3 border-t border-gray-100">
        <span id="paginationInfo" class="text-xs text-gray-400"></span>
        <div class="flex gap-2" id="paginationBtns"></div>
    </div>
</div>

<!-- MODAL -->
<div id="modalDesign" class="fixed inset-0 bg-black/60 hidden items-center justify-center p-4 z-50 backdrop-blur-sm">
    <div class="bg-white rounded-[2rem] w-full max-w-5xl shadow-2xl overflow-hidden max-h-[92vh] flex flex-col">
        <div class="p-5 border-b flex justify-between items-center bg-slate-900 text-white shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center">
                    <i class="fas fa-tools text-slate-900"></i>
                </div>
                <div>
                    <h2 class="font-black tracking-tight uppercase text-sm">Xử lý kỹ thuật dự án</h2>
                    <p class="text-[9px] text-slate-400 uppercase font-bold tracking-widest">Cập nhật tiến độ & Đồng bộ Drive</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex bg-slate-800 rounded-xl p-1 gap-1 text-[10px] font-bold">
                    <button type="button" onclick="switchModalTab('info')" id="tab-info" class="px-3 py-1.5 rounded-lg bg-blue-600 text-white transition">Thông tin</button>
                    <button type="button" onclick="switchModalTab('history')" id="tab-history" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition">Lịch sử</button>
                </div>
                <button type="button" onclick="closeModal()" class="w-8 h-8 flex items-center justify-center rounded-full hover:bg-slate-800 transition text-slate-400">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <form id="formDesign" class="flex-1 overflow-y-auto" onsubmit="handleSaveDesign(event)">
            <input type="hidden" id="design_id">

            <div id="tabContent-info" class="p-6 grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-4 space-y-4">
                    <h3 class="font-bold text-blue-600 uppercase text-[10px] tracking-widest flex items-center">
                        <i class="fas fa-info-circle mr-2"></i> Thông tin từ Sale
                    </h3>
                    <div class="bg-blue-50/60 p-5 rounded-2xl border border-blue-100">
                        <label class="block text-[9px] font-black text-blue-400 uppercase mb-1">Mã Đơn Hàng</label>
                        <p id="viewMaDH" class="text-lg font-black text-blue-800 uppercase tracking-tight">--</p>
                        <hr class="my-3 border-blue-200 border-dashed">
                        <label class="block text-[9px] font-black text-blue-400 uppercase mb-2">Hạng mục triển khai</label>
                        <div id="viewDauViec" class="flex flex-wrap gap-1.5"></div>
                    </div>
                    <div class="bg-slate-900 p-5 rounded-2xl text-white">
                        <p class="text-[9px] font-black text-slate-500 uppercase mb-3">Hành động nhanh</p>
                        <button type="button" id="btnOpenInput" class="w-full py-2.5 mb-2 bg-blue-600 rounded-xl font-bold text-xs uppercase hover:bg-blue-500 transition">
                            <i class="fab fa-google-drive mr-2"></i> Mở Folder INPUT
                        </button>
                        <button type="button" id="btnOpenOutput" class="w-full py-2.5 bg-emerald-600 rounded-xl font-bold text-xs uppercase hover:bg-emerald-500 transition">
                            <i class="fas fa-folder-open mr-2"></i> Mở Folder OUTPUT
                        </button>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-8 space-y-5">
                    <h3 class="font-bold text-orange-600 uppercase text-[10px] tracking-widest flex items-center">
                        <i class="fas fa-sync-alt mr-2"></i> Cập nhật tiến độ kỹ thuật
                    </h3>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[9px] font-black text-slate-400 uppercase mb-1.5">Người phụ trách</label>
                            <select id="designer" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm font-bold bg-gray-50 outline-none focus:border-blue-500" required></select>
                        </div>
                        <div>
                            <label class="block text-[9px] font-black text-slate-400 uppercase mb-1.5">Trạng thái</label>
                            <select id="ttThietKe" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm font-bold bg-gray-50 outline-none focus:border-orange-500">
                                <option value="Chưa giao việc">Chưa giao việc</option>
                                <option value="Đang xử lý">Đang xử lý</option>
                                <option value="Chuyển QL review">Chuyển QL review</option>
                                <option value="Đã hoàn thành">Đã hoàn thành</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <div>
                            <label class="block text-[9px] font-black text-slate-400 uppercase mb-1.5">Phiên bản</label>
                            <input type="text" id="version" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm font-black text-blue-600 text-center uppercase outline-none focus:border-blue-400" placeholder="V1.0">
                        </div>
                        <div>
                            <label class="block text-[9px] font-black text-slate-400 uppercase mb-1.5">Deadline</label>
                            <input type="date" id="deadline" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm font-bold outline-none focus:border-red-400">
                        </div>
                        <div>
                            <label class="block text-[9px] font-black text-slate-400 uppercase mb-1.5">Ghi chú</label>
                            <input type="text" id="feedbackTK" class="w-full border-2 border-slate-100 rounded-xl p-3 text-sm outline-none focus:border-blue-400" placeholder="Mô tả tiến độ...">
                        </div>
                    </div>
                    <div class="flex justify-end gap-3 pt-2">
                        <button type="button" onclick="closeModal()" class="px-5 py-2.5 text-gray-400 font-bold hover:text-red-500 transition uppercase text-[10px]">Đóng</button>
                        <button type="submit" class="bg-slate-900 text-white px-8 py-3 rounded-xl font-black shadow-xl hover:bg-black transition active:scale-95 uppercase text-[10px] tracking-widest flex items-center gap-2">
                            <i class="fas fa-check-circle text-emerald-400"></i> Cập nhật & Thông báo
                        </button>
                    </div>
                </div>
            </div>

            <div id="tabContent-history" class="p-6 hidden">
                <h3 class="font-bold text-purple-600 uppercase text-[10px] tracking-widest mb-4 flex items-center">
                    <i class="fas fa-history mr-2"></i> Lịch sử cập nhật
                </h3>
                <div id="historyTimeline" class="space-y-3"></div>
            </div>
        </form>
    </div>
</div>

</div>
</main>

<script>
let allDesignJobs = [];
let sortKey = 'id', sortDir = 1;
let currentPage = 1;
const pageSize = 15;

function updateKPIs(jobs) {
    const today = new Date(); today.setHours(0,0,0,0);
    document.getElementById('kpi-total').innerText = jobs.length;
    document.getElementById('kpi-processing').innerText = jobs.filter(j => j.ttThietKe === 'Đang xử lý').length;
    document.getElementById('kpi-unassigned').innerText = jobs.filter(j => j.ttThietKe === 'Chưa giao việc').length;
    document.getElementById('kpi-done').innerText = jobs.filter(j => j.ttThietKe === 'Đã hoàn thành').length;
    document.getElementById('kpi-overdue').innerText = jobs.filter(j => {
        if (!j.deadline || j.ttThietKe === 'Đã hoàn thành') return false;
        return new Date(j.deadline) < today;
    }).length;
}

function getDeadlineInfo(deadline, status) {
    if (!deadline || status === 'Đã hoàn thành') return { label: '--', cls: 'text-gray-300', overdue: false };
    const today = new Date(); today.setHours(0,0,0,0);
    const diff = Math.ceil((new Date(deadline) - today) / 86400000);
    if (diff < 0) return { label: `Trễ ${Math.abs(diff)} ngày`, cls: 'text-red-600 font-black', overdue: true };
    if (diff === 0) return { label: 'Hôm nay!', cls: 'text-orange-600 font-black', overdue: false };
    if (diff <= 3) return { label: `Còn ${diff} ngày`, cls: 'text-amber-600 font-bold', overdue: false };
    return { label: new Date(deadline).toLocaleDateString('vi-VN'), cls: 'text-gray-500', overdue: false };
}

function sortTable(key) {
    if (sortKey === key) sortDir *= -1; else { sortKey = key; sortDir = 1; }
    renderDesignTable(false);
}

async function renderDesignTable(reload = true) {
    try {
        if (reload) {
            const resp = await fetch('/api/design-jobs');
            allDesignJobs = await resp.json();
        }
        updateKPIs(allDesignJobs);

        const search = document.getElementById('searchDesign')?.value.toLowerCase() || '';
        const fStatus = document.getElementById('filterDesignStatus')?.value || 'Tất cả';
        const fStaff = document.getElementById('filterDesignStaff')?.value || 'Tất cả';
        const fDL = document.getElementById('filterDeadline')?.value || 'Tất cả';
        const today = new Date(); today.setHours(0,0,0,0);

        let filtered = allDesignJobs.filter(job => {
            const ms = job.maDH.toLowerCase().includes(search);
            const mst = fStatus === 'Tất cả' || job.ttThietKe === fStatus;
            const msf = fStaff === 'Tất cả' || job.designer === fStaff;
            let mdl = true;
            if (fDL !== 'Tất cả' && job.deadline && job.ttThietKe !== 'Đã hoàn thành') {
                const diff = Math.ceil((new Date(job.deadline) - today) / 86400000);
                if (fDL === 'Trễ hạn') mdl = diff < 0;
                else if (fDL === 'Sắp đến hạn') mdl = diff >= 0 && diff <= 3;
                else if (fDL === 'Trong hạn') mdl = diff > 3;
            }
            return ms && mst && msf && mdl;
        });

        filtered.sort((a, b) => {
            let va = a[sortKey] || '', vb = b[sortKey] || '';
            if (typeof va === 'string') return va.localeCompare(vb) * sortDir;
            return (va - vb) * sortDir;
        });

        const total = filtered.length;
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;
        const paged = filtered.slice((currentPage-1)*pageSize, currentPage*pageSize);

        document.getElementById('paginationInfo').innerText = `Hiển thị ${paged.length}/${total} dự án`;
        renderPagination(totalPages);

        const tbody = document.getElementById('design-tbody');
        if (!paged.length) {
            tbody.innerHTML = `<tr><td colspan="7" class="text-center py-12 text-gray-300 italic text-sm">Không có dữ liệu</td></tr>`;
            return;
        }

        tbody.innerHTML = paged.map(job => {
            const sCls = { 'Đã hoàn thành':'bg-emerald-100 text-emerald-700','Đang xử lý':'bg-blue-100 text-blue-700','Chuyển QL review':'bg-purple-100 text-purple-700','Chưa giao việc':'bg-gray-100 text-gray-500' }[job.ttThietKe] || 'bg-gray-100 text-gray-500';
            const dl = getDeadlineInfo(job.deadline, job.ttThietKe);
            const rowBg = dl.overdue ? 'bg-red-50/40' : '';
            const hasIn = job.driveLink && job.driveLink !== 'null' && job.driveLink !== '';
            const hasOut = job.outputFolderId && job.outputFolderId !== 'null' && job.outputFolderId !== '';
            return `
            <tr class="hover:bg-slate-50 transition-colors border-b border-gray-50 ${rowBg}">
                <td class="p-4"><span class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase ${sCls}">${job.ttThietKe}</span></td>
                <td class="p-4 font-bold text-slate-700 text-xs tracking-tight uppercase">${job.maDH}</td>
                <td class="p-4 text-xs font-bold text-gray-600">${job.designer||'<span class="text-gray-300 italic font-normal">Chưa giao</span>'}</td>
                <td class="p-4"><div class="flex flex-wrap gap-1">${(Array.isArray(job.dauViec)?job.dauViec:[]).map(d=>`<span class="text-[9px] bg-gray-100 px-1.5 py-0.5 rounded text-gray-500 font-bold">${d}</span>`).join('')}</div></td>
                <td class="p-4 font-mono text-xs text-blue-600 font-bold">${job.version||'V1.0'}</td>
                <td class="p-4 text-xs ${dl.cls}">${dl.label}</td>
                <td class="p-4">
                    <div class="flex justify-center gap-1.5">
                        <button onclick="openOrderFolder(${job.orderId}, 'in-design')" title="INPUT" class="w-7 h-7 rounded-lg text-xs flex items-center justify-center ${hasIn?'bg-blue-50 text-blue-600 hover:bg-blue-100':'bg-gray-50 text-gray-300 cursor-not-allowed'}"><i class="fab fa-google-drive"></i></button>
                        <button onclick="openOrderFolder(${job.orderId}, 'thietke')" title="OUTPUT" class="w-7 h-7 rounded-lg text-xs flex items-center justify-center ${hasOut?'bg-emerald-50 text-emerald-600 hover:bg-emerald-100':'bg-gray-50 text-gray-300 cursor-not-allowed'}"><i class="fas fa-folder"></i></button>
                        <button onclick="openModal(${job.id})" class="bg-slate-900 text-white px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase hover:bg-black transition">Xử lý</button>
                        <button onclick="deleteDesignJob(${job.id})" class="text-red-300 hover:text-red-600 p-1.5 transition"><i class="fas fa-trash-alt text-xs"></i></button>
                    </div>
                </td>
            </tr>`;
        }).join('');
    } catch(e) { console.error(e); }
}

function renderPagination(total) {
    document.getElementById('paginationBtns').innerHTML = Array.from({length:total},(_,i)=>i+1).map(i=>
        `<button onclick="goPage(${i})" class="w-8 h-8 rounded-lg text-xs font-bold transition ${i===currentPage?'bg-blue-600 text-white':'bg-gray-100 text-gray-500 hover:bg-gray-200'}">${i}</button>`
    ).join('');
}

function goPage(p) { currentPage = p; renderDesignTable(false); }

function switchModalTab(tab) {
    ['info','history'].forEach(t => {
        const btn = document.getElementById(`tab-${t}`);
        const cnt = document.getElementById(`tabContent-${t}`);
        if (btn) btn.className = t === tab ? 'px-3 py-1.5 rounded-lg bg-blue-600 text-white transition' : 'px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition';
        if (cnt) cnt.classList.toggle('hidden', t !== tab);
    });
}

async function openModal(id) {
    const job = allDesignJobs.find(x => x.id === id);
    if (!job) return;
    document.getElementById('design_id').value = job.id;
    document.getElementById('viewMaDH').innerText = job.maDH;
    document.getElementById('viewDauViec').innerHTML = (Array.isArray(job.dauViec)?job.dauViec:[]).map(item=>
        `<span class="bg-blue-100 text-blue-700 text-[9px] px-2 py-0.5 rounded-md font-bold border border-blue-200">${item}</span>`
    ).join('') || '<span class="text-gray-400 italic text-xs">Không có</span>';

    const res = await fetch('/api/users/technicians');
    const techs = await res.json();
    document.getElementById('designer').innerHTML = '<option value="">-- Chọn NV phụ trách --</option>' +
        techs.map(u=>`<option value="${u.name}" ${job.designer===u.name?'selected':''}>${u.name}</option>`).join('');

    document.getElementById('ttThietKe').value = job.ttThietKe || 'Chưa giao việc';
    document.getElementById('version').value = job.version || 'V1.0';
    document.getElementById('feedbackTK').value = job.feedbackTK || '';
    document.getElementById('deadline').value = job.deadline || '';
    document.getElementById('btnOpenInput').onclick = () => openOrderFolder(job.orderId, 'in-design');
    document.getElementById('btnOpenOutput').onclick = () => openOrderFolder(job.orderId, 'thietke');

    const history = Array.isArray(job.history) ? job.history : [];
    const hc = document.getElementById('historyTimeline');
    hc.innerHTML = history.length ? history.slice().reverse().map(h=>`
        <div class="flex gap-3">
            <div class="flex flex-col items-center">
                <div class="w-2.5 h-2.5 rounded-full bg-blue-400 mt-1 shrink-0"></div>
                <div class="w-px flex-1 bg-gray-200 mt-1"></div>
            </div>
            <div class="pb-4 flex-1">
                <div class="flex items-center gap-2 mb-0.5">
                    <span class="text-[10px] font-black text-slate-600 uppercase">${h.status}</span>
                    <span class="text-[9px] text-gray-400">• ${h.by}</span>
                </div>
                <p class="text-xs text-gray-500">${h.note||''}</p>
                <p class="text-[9px] text-gray-300 mt-0.5">${new Date(h.at).toLocaleString('vi-VN')}</p>
            </div>
        </div>
    `).join('') : '<p class="text-gray-400 text-sm italic text-center py-8">Chưa có lịch sử</p>';

    switchModalTab('info');
    const m = document.getElementById('modalDesign');
    m.classList.remove('hidden'); m.classList.add('flex');
}

async function handleSaveDesign(e) {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const orig = btn.innerHTML;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Đang lưu...';
    btn.disabled = true;
    try {
        const resp = await fetch('/api/design-jobs/save', {
            method: 'POST', headers: {'Content-Type':'application/json'},
            body: JSON.stringify({
                id: document.getElementById('design_id').value,
                designer: document.getElementById('designer').value,
                ttThietKe: document.getElementById('ttThietKe').value,
                version: document.getElementById('version').value,
                feedbackTK: document.getElementById('feedbackTK').value,
                deadline: document.getElementById('deadline').value,
                maDH: document.getElementById('viewMaDH').innerText
            })
        });
        const r = await resp.json();
        if (r.success) { closeModal(); renderDesignTable(); }
        else alert('Lỗi lưu dữ liệu!');
    } catch { alert('Lỗi kết nối server!'); }
    finally { btn.innerHTML = orig; btn.disabled = false; }
}

function openDriveLink(id) {
    if (!id || id === 'null' || id === '') { alert('Thư mục chưa được khởi tạo!'); return; }
    window.open(`https://drive.google.com/drive/folders/${id}`, '_blank');
}

function closeModal() {
    const m = document.getElementById('modalDesign');
    m.classList.add('hidden'); m.classList.remove('flex');
}

async function deleteDesignJob(id) {
    if (!confirm('Xóa dự án kỹ thuật này?')) return;
    await fetch(`/api/design-jobs/${id}`, { method: 'DELETE' });
    renderDesignTable();
}

async function initFilters() {
    const res = await fetch('/api/users/technicians');
    const techs = await res.json();
    const sel = document.getElementById('filterDesignStaff');
    if (sel) sel.innerHTML = '<option value="Tất cả">Tất cả nhân viên</option>' +
        techs.map(u=>`<option value="${u.name}">${u.name}</option>`).join('');
}

window.onload = async () => { await initFilters(); await renderDesignTable(); };
</script>

