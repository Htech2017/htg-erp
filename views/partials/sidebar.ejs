<style>
    .custom-scrollbar::-webkit-scrollbar { width: 3px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 10px; }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Chi de an/hien menu. Quyen thuc su duoc kiem tra o server (src/config.js).
    const myRoles = <%- JSON.stringify((typeof user !== 'undefined' && user && user.allRoles) || []).replace(/</g, '\\u003c') %>;
    const isAdmin = myRoles.includes('Admin');
    const currentPath = window.location.pathname;

    document.querySelectorAll('.nav-item').forEach(link => {
        const allowedRoles = link.getAttribute('data-role');

        // Kiểm tra quyền
        if (allowedRoles) {
            const roles = allowedRoles.split(',').map(r => r.trim());
            if (!isAdmin && !roles.some(r => myRoles.includes(r))) {
                link.style.display = 'none';
            }
        }

        // Active state
        const href = link.getAttribute('href');
        if (href && href === currentPath) {
            link.classList.add('bg-indigo-600', 'text-white');
        }
    });

    // Ẩn section headers nếu không có menu nào trong section đó
    document.querySelectorAll('nav > div.pt-3').forEach(section => {
        let next = section.nextElementSibling;
        let hasVisible = false;
        while (next && !next.classList.contains('pt-3')) {
            if (next.tagName === 'A' && next.style.display !== 'none') {
                hasVisible = true;
                break;
            }
            next = next.nextElementSibling;
        }
        if (!hasVisible) section.style.display = 'none';
    });
});
</script>
